void drawChannelAnalysisPage() {
  int w=tft.width(), h=tft.height();
  struct Rank { uint8_t ch; uint32_t hits; int16_t rssi; };
  Rank top[8] = {};
  for (uint8_t i=0;i<NUM_CHANNELS;i++) {
    uint8_t ch=CHANNELS[i]; uint32_t hits=channelHits[ch];
    if(!hits) continue;
    for(int p=0;p<8;p++) if(hits>top[p].hits) {
      for(int q=7;q>p;q--) top[q]=top[q-1];
      top[p]={ch,hits,channelBestRssi[ch]}; break;
    }
  }

  static Rank shown[8] = {};
  static int shownBw[8] = {-1,-1,-1,-1,-1,-1,-1,-1};
  static uint32_t shown24=0xFFFFFFFFUL, shown5=0xFFFFFFFFUL;
  static bool shownEmpty=false;

  if(channelPopularityNeedsFullDraw) {
    // drawPage() has already cleared the screen and painted the common header/nav.
    // Paint the immutable popularity chrome once and invalidate only the dynamic cache.
    textAt(8,40,"CHANNEL POPULARITY",C_CYAN,1);
    textAt(8,53,"tap LIVE for SMART CHANNELS",C_LIGHTGREY,1);
    memset(shown,0,sizeof(shown));
    for(int i=0;i<8;i++) shownBw[i]=-1;
    shown24=shown5=0xFFFFFFFFUL;
    shownEmpty=false;
    channelPopularityNeedsFullDraw=false;
  }

  uint32_t peak=top[0].hits?top[0].hits:1;
  for(int i=0;i<8;i++) {
    int y=73+i*24;
    int bw=0;
    if(top[i].hits) { bw=(int)((uint64_t)top[i].hits*92/peak); if(bw<2)bw=2; }
    const bool changed=(top[i].ch!=shown[i].ch || top[i].hits!=shown[i].hits ||
                        top[i].rssi!=shown[i].rssi || bw!=shownBw[i]);
    if(!changed) continue;

    // Clear only this row. Everything outside it remains untouched.
    tft.fillRect(7,y-3,w-14,14,C_BLACK);
    if(top[i].hits) {
      bool band5=top[i].ch>14;
      textAt(9,y,String("CH ")+top[i].ch,band5?C_MAGENTA:C_GREEN,1);
      tft.drawRect(58,y-2,96,11,C_DARKGREY);
      tft.fillRect(60,y,bw,7,C_ACCENT);
      textAt(160,y,String(top[i].hits)+"  "+top[i].rssi+"dBm",C_WHITE,1);
    }
    shown[i]=top[i]; shownBw[i]=bw;
  }

  const bool empty=!top[0].hits;
  if(empty!=shownEmpty) {
    tft.fillRect(18,89,w-36,14,C_BLACK);
    if(empty) textAt(20,92,"No GPS-gated WiFi records yet.",C_LIGHTGREY,1);
    shownEmpty=empty;
  }

  if(total24!=shown24 || total5!=shown5) {
    fillTextAt(9,h-50,w-18,11,String("2.4G ")+total24+"   5G "+total5,C_WHITE,1,C_BLACK);
    shown24=total24; shown5=total5;
  }
}
