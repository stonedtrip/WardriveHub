void drawNodesPage() {
  int w=tft.width(), h=tft.height();

  // Cluster/Core summary belongs here rather than consuming Dashboard space.
  panel(7,38,w-14,58,"CLUSTER");
  textAt(17,61,String(nodeCount),C_GREEN,3);
  textAt(62,63,String("ONLINE / ")+MAX_NODES,C_WHITE,1);
  textAt(62,79,"ESP-NOW CH 6",C_LIGHTGREY,1);

  int y=102;
  int rowH=43;
  uint8_t shown=0;
  for(uint8_t i=0;i<MAX_NODES;i++) {
    if(!nodes[i].active) continue;
    if(y+rowH > h-40) break;
    tft.fillRoundRect(7,y,w-14,rowH-4,5,C_PANEL);
    String mode=nodeModeName(nodes[i].statusSeen?nodes[i].reportedScanMode:nodes[i].desiredScanMode);
    bool scan=(nodes[i].statusFlags&0x04)!=0;
    bool ngps=(nodes[i].statusFlags&0x02)!=0;
    textAt(14,y+4,String("N")+(i+1)+" "+shortMac(nodes[i].mac)+" "+mode,C_WHITE,1);
    textAt(14,y+17,String((wardriveActive && nodes[i].desiredRun && !gpsFix())?"GPS WAIT":((nodes[i].statusFlags&0x08)?"RUN ACK":(nodes[i].desiredRun?"RUN PENDING":"PAUSED")))+" "+(scan?"SCANNING":"NO SCAN"),
           scan?C_GREEN:C_YELLOW,1);
    String counts=String("RAW ")+nodes[i].wifiRecords+"W/"+nodes[i].bleRecordsNode+"B";
    String transport = nodes[i].reliableAckCapable ? (nodes[i].reliableAckImmediateFail ? "ACK RETRY" : "ACK OK") :
                       (nodes[i].statusSeen ? ((nodes[i].statusFlags&0x10)?"BLE OK":"BLE N/A") : "BLE ?");
    if(nodes[i].reliableAckCapable && nodes[i].transportRecoveries)
      transport=String("REC ")+nodes[i].transportRecoveries+" ACK "+nodes[i].reliableAcksSent;
    textAt(14,y+28,transport,nodes[i].reliableAckCapable?C_GREEN:((nodes[i].statusFlags&0x10)?C_CYAN:C_YELLOW),1);
    textAt(w-10-(counts.length()*6),y+28,counts,C_LIGHTGREY,1);
    y+=rowH; shown++;
  }
  if(!shown) {
    textAt(20,124,"No mesh nodes connected.",C_LIGHTGREY,1);
    textAt(20,141,"CYD standalone capture active",C_GREEN,1);
  }
}

double liveWorldPixelX(double lon, uint8_t zoom) {
  const double scale=(double)(1UL<<zoom)*LIVE_TILE_SIZE;
  return (lon+180.0)/360.0*scale;
}
double liveWorldPixelY(double lat, uint8_t zoom) {
  if(lat>85.05112878)lat=85.05112878;
  if(lat<-85.05112878)lat=-85.05112878;
  const double radians=lat*DEG_TO_RAD;
  const double scale=(double)(1UL<<zoom)*LIVE_TILE_SIZE;
  return (1.0-asinh(tan(radians))/PI)*0.5*scale;
}
bool ensureLiveMapSd() {
  if(liveMapSdReady) return true;
  liveMapSdReady=wdhStorageEnsureMounted();
  if(liveMapSdReady) csvSessionSdReady=true;
  return liveMapSdReady;
}
String liveMapTilePath(uint8_t zoom,int32_t tx,int32_t ty) {

  String universal="/maps/tiles/"+String(zoom)+"/"+String(tx)+"/"+String(ty)+".rgb";
  if(SD.exists(universal)) return universal;
  String legacy="/maps/wnc/"+String(zoom)+"/"+String(tx)+"/"+String(ty)+".rgb";
  if(SD.exists(legacy)) return legacy;
  return "";
}
bool liveCenterTileExists(double lat,double lon,uint8_t zoom) {
  double wx=liveWorldPixelX(lon,zoom), wy=liveWorldPixelY(lat,zoom);
  int32_t tx=(int32_t)floor(wx/LIVE_TILE_SIZE), ty=(int32_t)floor(wy/LIVE_TILE_SIZE);
  return liveMapTilePath(zoom,tx,ty).length()>0;
}
bool resolveLiveMapZoom(double lat,double lon) {
  if(liveCenterTileExists(lat,lon,LIVE_MAP_ZOOM_DEFAULT)){
    liveMapZoom=LIVE_MAP_ZOOM_DEFAULT; liveMapZoomResolved=true; return true;
  }
  for(uint8_t d=1; d<=9; d++){
    int hi=(int)LIVE_MAP_ZOOM_DEFAULT+d;
    if(hi<=LIVE_MAP_ZOOM_MAX && liveCenterTileExists(lat,lon,(uint8_t)hi)){
      liveMapZoom=(uint8_t)hi; liveMapZoomResolved=true; return true;
    }
    int lo=(int)LIVE_MAP_ZOOM_DEFAULT-d;
    if(lo>=LIVE_MAP_ZOOM_MIN && liveCenterTileExists(lat,lon,(uint8_t)lo)){
      liveMapZoom=(uint8_t)lo; liveMapZoomResolved=true; return true;
    }
  }
  liveMapZoomResolved=true; return false;
}

static float liveAngleDelta(float a,float b) {
  float d=fmodf(a-b+540.0f,360.0f)-180.0f;
  return fabsf(d);
}

static float liveReliableHeading() {
  float c=activeGpsCourseDeg();
  float mph=activeGpsSpeedMph();
  if(c>=0.0f && mph>=LIVE_HEADING_MIN_MPH) {
    if(!liveMapHeadingValid) liveMapHeadingDeg=c;
    else {
      float d=fmodf(c-liveMapHeadingDeg+540.0f,360.0f)-180.0f;
      // Smooth GPS course so small jitter does not make the map twitch.
      liveMapHeadingDeg += d*0.35f;
      if(liveMapHeadingDeg<0) liveMapHeadingDeg+=360.0f;
      if(liveMapHeadingDeg>=360.0f) liveMapHeadingDeg-=360.0f;
    }
    liveMapHeadingValid=true;
  }
  return liveMapHeadingValid?liveMapHeadingDeg:0.0f;
}

static bool ensureLiveRotBuffer() {
  if(liveRotMap) return true;
  size_t bytes=(size_t)LIVE_ROT_SRC*LIVE_ROT_SRC*sizeof(uint16_t);
  liveRotMap=(uint16_t*)ps_malloc(bytes);
  if(!liveRotMap) liveRotMap=(uint16_t*)malloc(bytes);
  return liveRotMap!=nullptr;
}

static bool loadLiveNorthUpSource(double centerLat,double centerLon) {
  if(!ensureLiveRotBuffer()) return false;
  static bool cacheValid=false;
  static double cachedLat=0,cachedLon=0;
  static uint8_t cachedZoom=0;
  static uint32_t cachedGeneration=0,cachedMs=0;
  const uint32_t now=millis();
  if(cacheValid && centerLat==cachedLat && centerLon==cachedLon && liveMapZoom==cachedZoom &&
     cachedGeneration==wdhStorageGeneration && (uint32_t)(now-cachedMs)<30000UL) return true;
  cacheValid=false;
  bool complete=true;
  for(int i=0;i<LIVE_ROT_SRC*LIVE_ROT_SRC;i++) liveRotMap[i]=C_PANEL;
  double cwx=liveWorldPixelX(centerLon,liveMapZoom);
  double cwy=liveWorldPixelY(centerLat,liveMapZoom);
  double left=cwx-LIVE_ROT_SRC/2.0, top=cwy-LIVE_ROT_SRC/2.0;
  int32_t firstX=(int32_t)floor(left/LIVE_TILE_SIZE);
  int32_t firstY=(int32_t)floor(top/LIVE_TILE_SIZE);
  int32_t lastX=(int32_t)floor((left+LIVE_ROT_SRC-1)/LIVE_TILE_SIZE);
  int32_t lastY=(int32_t)floor((top+LIVE_ROT_SRC-1)/LIVE_TILE_SIZE);
  int32_t limit=1L<<liveMapZoom;
  for(int32_t ty=firstY;ty<=lastY;ty++) for(int32_t tx=firstX;tx<=lastX;tx++) {
    if(tx<0||ty<0||tx>=limit||ty>=limit) continue;
    String path=liveMapTilePath(liveMapZoom,tx,ty);
    File f=SD.open(path,FILE_READ); if(!f || f.size()!=131072){if(f)f.close();complete=false;continue;}
    int dstX=(int)lround(tx*LIVE_TILE_SIZE-left);
    int dstY=(int)lround(ty*LIVE_TILE_SIZE-top);
    for(int row=0;row<LIVE_TILE_SIZE;row++) {
      int dy=dstY+row;
      if(dy<0||dy>=LIVE_ROT_SRC) continue;
      int srcX=0, dx=dstX, count=LIVE_TILE_SIZE;
      if(dx<0){srcX=-dx;count-=srcX;dx=0;}
      if(dx+count>LIVE_ROT_SRC)count=LIVE_ROT_SRC-dx;
      if(count<=0)continue;
      if(!f.seek(((uint32_t)row*LIVE_TILE_SIZE+(uint32_t)srcX)*2U) ||
         f.read((uint8_t*)(liveRotMap+(size_t)dy*LIVE_ROT_SRC+dx),(size_t)count*2U)!=(size_t)count*2U) complete=false;
    }
    f.close();
  }
  cacheValid=complete;
  cachedLat=centerLat; cachedLon=centerLon; cachedZoom=liveMapZoom;
  cachedGeneration=wdhStorageGeneration; cachedMs=now;
  return true;
}

static void liveWorldVectorToHeadingScreen(double lat,double lon,double centerLat,double centerLon,float heading,int16_t &sx,int16_t &sy) {
  double dx=liveWorldPixelX(lon,liveMapZoom)-liveWorldPixelX(centerLon,liveMapZoom);
  double dy=liveWorldPixelY(lat,liveMapZoom)-liveWorldPixelY(centerLat,liveMapZoom);
  float r=heading*DEG_TO_RAD, c=cosf(r), sn=sinf(r);
  double rx=c*dx+sn*dy;
  double ry=-sn*dx+c*dy;
  sx=(int16_t)lround(tft.width()/2.0+rx);
  sy=(int16_t)lround(LIVE_MAP_Y+LIVE_MAP_H/2.0+ry);
}

static bool drawHeadingUpMapSurface(double centerLat,double centerLon,float heading) {
  if(!loadLiveNorthUpSource(centerLat,centerLon)) return false;
  int w=tft.width();
  float r=heading*DEG_TO_RAD,c=cosf(r),sn=sinf(r);
  int outCx=w/2, outCy=LIVE_MAP_H/2, srcC=LIVE_ROT_SRC/2;
  static uint16_t outLine[320];
  for(int oy=0;oy<LIVE_MAP_H;oy++) {
    int dy=oy-outCy;
    for(int ox=0;ox<w;ox++) {
      int dx=ox-outCx;
      // Inverse rotation: sample north-up source for this course-up output pixel.
      int sx=(int)lroundf(srcC+c*dx-sn*dy);
      int sy=(int)lroundf(srcC+sn*dx+c*dy);
      outLine[ox]=(sx>=0&&sx<LIVE_ROT_SRC&&sy>=0&&sy<LIVE_ROT_SRC)?liveRotMap[(size_t)sy*LIVE_ROT_SRC+sx]:C_PANEL;
    }
    tft.drawRGBBitmap(0,LIVE_MAP_Y+oy,outLine,w,1);
  }
  return true;
}

