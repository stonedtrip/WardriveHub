// Uploading needs a bigger INTERNAL heap than normal wardriving. The 8MB
// PSRAM can hold history, but the Arduino mbedTLS allocator typically still
// needs internal RAM. Do not release BLE controller memory permanently:
// BLEDevice::deinit(true) would prevent reinitialization until reboot.
static bool uploadSavedCaptureArmed=false;
static bool uploadSavedNodeRun[MAX_NODES]={};
static bool uploadBleWasInitialized=false;

static void uploadMemorySnapshot(const char *phase) {
  Serial.printf("[UPLOAD MEM] %s internal_free=%u internal_largest=%u psram_free=%u psram_largest=%u\n",
                phase,
                (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
                (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
                (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT),
                (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT));
}

static bool beginUploadMaintenance() {
  if (uploadMaintenanceActive) {
    Serial.println("[UPLOAD MEM] Already in upload transaction; refusing nested upload");
    return false;
  }
  uploadSavedCaptureArmed=wardriveActive;
  for(uint8_t i=0;i<MAX_NODES;i++) uploadSavedNodeRun[i]=nodes[i].desiredRun;
  uploadMaintenanceActive=true;
  uploadMemorySnapshot("before pause");
  // Uses existing GPS-gated NODE_CONFIG run_enabled=0 protocol; prevents
  // local capture and flushes pending CSV data before changing radio mode.
  setWardriveActive(false);
  stopStandalonePromisc();
  standaloneWifiScanPending=false;
  standaloneScanning=false;
  // Allow the 3 STOP packets to leave the Wi-Fi driver before ESP-NOW teardown.
  wdhCooperativeWait(350);
  // BLE has already been initialized at boot, even when Core-only mesh mode
  // is active. Its host/controller resources compete with TLS for internal RAM.
  // Temporary deinit WITHOUT release_memory: scanner can be initialized again.
  uploadBleWasInitialized=cydBleReady;
  if (uploadBleWasInitialized) {
    BLEScan *bleScan=BLEDevice::getScan();
    if (bleScan) bleScan->stop();
    BLEDevice::deinit(false);
    cydBleReady=false;
  }
  uploadMemorySnapshot("after BLE pause");
  return true;
}

bool connectUploadWifi(){
  if(!loadUploadConfig()){
    if(!uploadStatus.length()) uploadStatus="CONFIG MISSING";
    drawUploadProgress("UPLOAD",UP_FAILED,-1,uploadStatus);
    return false;
  }
  if(!beginUploadMaintenance()) {uploadStatus="UPLOAD BUSY";return false;}

  uploadStatus="CONNECTING TO WI-FI";
  drawUploadProgress("UPLOAD",UP_CONNECTING,-1,uploadWifiSsid);

  // Upload needs the station radio free to follow the access point's channel.
  // ESP-NOW normally pins the core to channel 6, which can prevent association
  // with an AP on another channel. Suspend it only for the upload transaction.
  if(!espNowSuspendedForStandaloneScan){
    esp_now_deinit();
    espNowSuspendedForStandaloneScan=true;
  }
  WiFi.disconnect(true,false);
  wdhCooperativeWait(80);
  WiFi.mode(WIFI_STA);
#if CONFIG_SOC_WIFI_SUPPORT_5G
  WiFi.setBandMode(WIFI_BAND_MODE_AUTO);
#endif
  WiFi.setAutoReconnect(false);
  WiFi.begin(uploadWifiSsid.c_str(),uploadWifiPass.c_str());

  uint32_t t=millis();
  wl_status_t lastStatus=WiFi.status();
  while(WiFi.status()!=WL_CONNECTED && millis()-t<20000UL){
    wl_status_t st=WiFi.status();
    if(st!=lastStatus){lastStatus=st;}
    if(externalGpsEnabled){uint8_t budget=0;while(GPSSerial.available()&&budget++<32)gps.encode(GPSSerial.read());}
    touchTick();delay(10);
  }
  wl_status_t st=WiFi.status();
  if(st!=WL_CONNECTED){
    String why="WI-FI TIMEOUT";
    if(st==WL_NO_SSID_AVAIL) why="SSID NOT FOUND";
    else if(st==WL_CONNECT_FAILED) why="PASSWORD / AUTH FAILED";
    else if(st==WL_CONNECTION_LOST) why="CONNECTION LOST";
    else if(st==WL_DISCONNECTED) why="AP DISCONNECTED";
    uploadStatus="WIFI FAILED";
    drawUploadProgress("UPLOAD",UP_FAILED,-1,why);
    return false;
  }
  uploadStatus="WI-FI CONNECTED";
  uploadMemorySnapshot("connected / before TLS");
  drawUploadProgress("UPLOAD",UP_PREPARING,0,WiFi.localIP().toString());
  return true;
}

void restoreCoreAfterUpload(){
  if(!uploadMaintenanceActive) return;
  WiFi.disconnect(true,false);wdhCooperativeWait(80);
  espNowSuspendedForStandaloneScan=false;
#if CONFIG_SOC_WIFI_SUPPORT_5G
  WiFi.setBandMode(WIFI_BAND_MODE_2G_ONLY);
#endif
  bool radioRestored=startCoreRadio();
  if (uploadBleWasInitialized) {
    startLocalBleScanner();
    uploadBleWasInitialized=false;
  }
  uploadMemorySnapshot("after radio/BLE restore");
  if(!radioRestored) {
    // Fail CLOSED: no accidental scanning if ESP-NOW cannot be restored.
    uploadStatus="CORE RADIO RESTORE FAIL";
    Serial.println("[UPLOAD MEM] ERROR ESP-NOW restore failed; capture stays paused");
    uploadMaintenanceActive=false;
    return;
  }
  // Restore each independent node's original RUN intent BEFORE sending RUN
  // configs; no brief unwanted RUN pulse on manually paused nodes.
  for(uint8_t i=0;i<MAX_NODES;i++) {
    if(!nodes[i].active) continue;
    nodes[i].desiredRun=uploadSavedNodeRun[i];
    nodes[i].configGeneration++;
    if(!nodes[i].configGeneration) nodes[i].configGeneration=1;
  }
  uploadMaintenanceActive=false;
  if(uploadSavedCaptureArmed) {
    uploadPreserveNodeStateOnResume=true;
    setWardriveActive(true);
    uploadPreserveNodeStateOnResume=false;
  }
  sendAllNodeConfigs();
  Serial.printf("[UPLOAD MEM] restored capture=%u; prior node RUN flags preserved\n",
                uploadSavedCaptureArmed?1:0);
}

bool streamCsvUpload(const String& host,const String& path,const String& hn,const String& hv,
                     const String& csv,bool wigle,int& code,String& responseBody){
  String service=wigle?"WIGLE":"WDGWARS";
  File f=SD.open(csv,"r");if(!f){uploadStatus="FILE OPEN FAIL";drawUploadProgress(service,UP_FAILED,-1,"FILE OPEN FAIL");return false;}
  drawUploadProgress(service,UP_PREPARING,0,sessionDisplayName(csv));
  String b="----WardriveHubESP32";
  String pre="--"+b+"\r\n";
  if(wigle)pre+="Content-Disposition: form-data; name=\"donate\"\r\n\r\nfalse\r\n--"+b+"\r\n";
  pre+="Content-Disposition: form-data; name=\"file\"; filename=\""+sessionDisplayName(csv)+"\"\r\nContent-Type: text/csv\r\n\r\n";
  String post="\r\n--"+b+"--\r\n";
  size_t len=pre.length()+f.size()+post.length();
  WiFiClientSecure c;c.setInsecure();c.setTimeout(20000); c.setHandshakeTimeout(20);
  if(!c.connect(host.c_str(),443)){
    char tlsDetail[112]={0};
    int tlsErr=c.lastError(tlsDetail,sizeof(tlsDetail));
    Serial.printf("[UPLOAD] %s TLS failure: code=%d detail=%s heap=%lu\n",host.c_str(),tlsErr,tlsDetail,(unsigned long)ESP.getFreeHeap());
    f.close();uploadStatus="TLS CONNECT FAIL";drawUploadProgress(service,UP_FAILED,-1,"TLS CONNECT FAIL");return false;
  }
  c.print("POST "+path+" HTTP/1.1\r\nHost: "+host+"\r\nUser-Agent: WardriveHub-NM-CYD-C5/"+String(WARDHUB_FW_VERSION)+"\r\nAccept: application/json\r\n");
  c.print(hn+": "+hv+"\r\nContent-Type: multipart/form-data; boundary="+b+"\r\nContent-Length: "+String(len)+"\r\nConnection: close\r\n\r\n");
  c.print(pre);uint8_t buf[768];
  const uint32_t fileTotal=(uint32_t)f.size(); uint32_t fileSent=0; int lastPct=-1;
  drawUploadProgress(service,UP_SENDING,0,sessionDisplayName(csv));
  while(f.available()){
    size_t n=f.read(buf,sizeof(buf));
    if(n){
      size_t wr=c.write(buf,n);
      if(wr!=n){f.close();c.stop();uploadStatus=service+" SEND FAILED";drawUploadProgress(service,UP_FAILED,lastPct<0?0:lastPct,"CONNECTION LOST");return false;}
      fileSent+=(uint32_t)wr;
      int pct=fileTotal?int((fileSent*100ULL)/fileTotal):100;
      if(pct!=lastPct){lastPct=pct;uploadStatus=service+" "+String(pct)+"%";drawUploadProgress(service,UP_SENDING,pct,sessionDisplayName(csv));}
    }
    if(externalGpsEnabled){uint8_t budget=0;while(GPSSerial.available()&&budget++<32)gps.encode(GPSSerial.read());}
    touchTick();delay(0);
  }
  f.close();c.print(post);
  uploadStatus="VERIFYING "+service; drawUploadProgress(service,UP_VERIFYING,100,"WAITING FOR SERVER");
  uint32_t t=millis();while(!c.available()&&c.connected()&&millis()-t<20000UL){touchTick();delay(10);}
  String st=c.readStringUntil('\n');st.trim();code=0;int sp=st.indexOf(' ');if(sp>0)code=st.substring(sp+1).toInt();
  responseBody="";
  bool body=false; uint32_t rt=millis();
  while((c.connected()||c.available()) && millis()-rt<5000UL){
    while(c.available()){
      String line=c.readStringUntil('\n');
      if(!body){ if(line=="\r"||line.length()==0) body=true; }
      else if(responseBody.length()<1024) responseBody+=line;
      rt=millis();
    }
    delay(1);
  }
  c.stop();return code>=200&&code<300;
}

// Keep per-service upload results on SD. No API keys are written to history.
void cydUploadHistory(const String& path,const String& service,int code,bool ok){
  if(!ensureUploadSd())return;
  File h=SD.open("/upload_history.csv",FILE_APPEND);
  if(!h)return;
  String safe=sessionDisplayName(path);safe.replace(',', '_');safe.replace('\r','_');safe.replace('\n','_');
  h.print(millis());h.print(',');h.print(safe);h.print(',');h.print(service);
  h.print(',');h.print(code);h.print(',');h.println(ok?"OK":"FAILED");h.close();
}

// Signal Frontier v2.5.1 device API: authenticated identity, multipart CSV,
// then status polling. HTTP 202 means QUEUED, not completed.
struct SfHttpResult { int code=0; String body; };

static bool sfSafeHost(String host){
  if(host.length()==0 || host.length()>120 || host.startsWith(".") || host.endsWith("."))return false;
  for(size_t i=0;i<host.length();i++){
    char c=host[i];
    if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='.'||c=='-'))return false;
  }
  return true;
}
static String sfJsonField(const String& json,const String& name){
  int p=json.indexOf(String("\"")+name+"\"");
  if(p<0)return "";
  p=json.indexOf(':',p+name.length()+2);
  if(p<0)return "";
  p++;while(p<(int)json.length() && (json[p]==' '||json[p]=='\r'||json[p]=='\n'))p++;
  if(p>=(int)json.length())return "";
  if(json[p]=='"'){
    int e=json.indexOf('"',p+1);
    if(e<0)return "";
    return json.substring(p+1,e);
  }
  int e=p;
  while(e<(int)json.length() && json[e]!=',' && json[e]!='}' && json[e]!='\r' && json[e]!='\n')e++;
  String v=json.substring(p,e);v.trim();return v;
}
static int sfReadResponse(WiFiClientSecure& c,String& body){
  body="";
  uint32_t began=millis();
  while(!c.available() && c.connected() && (uint32_t)(millis()-began)<25000UL){delay(10);}
  if(!c.available())return -4;
  String first=c.readStringUntil('\n');int sp=first.indexOf(' ');
  int code=(sp>=0)?first.substring(sp+1).toInt():0;
  bool endedHeaders=false;
  for(int i=0;i<50;i++){
    if(!c.connected() && !c.available())break;
    String line=c.readStringUntil('\n');line.trim();
    if(!line.length()){endedHeaders=true;break;}
  }
  if(!endedHeaders)return code?code:-4;
  uint32_t lastByte=millis();
  while((uint32_t)(millis()-began)<30000UL){
    bool any=false;
    while(c.available()){
      int ch=c.read(); if(ch<0)break;
      if(body.length()<3072)body+=(char)ch;
      any=true;
    }
    if(any)lastByte=millis();
    if(!c.connected()&&!c.available())break;
    if((uint32_t)(millis()-lastByte)>1800UL)break;
    delay(5);
  }
  return code?code:-4;
}
static int sfHttpsGet(const String& host,const String& key,const String& path,String& response){
  response="";
  if(!sfSafeHost(host)||key.indexOf('\n')>=0||key.indexOf('\r')>=0)return -8;
  WiFiClientSecure c;c.setInsecure();c.setTimeout(20000);c.setHandshakeTimeout(20);
  if(!c.connect(host.c_str(),443)){
    char err[100]={0};int n=c.lastError(err,sizeof(err));
    Serial.printf("[SIGNAL FRONTIER] TLS error %d: %s | internal_free=%u\n",n,err,
      (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT));
    c.stop();return -3;
  }
  c.print("GET "+path+" HTTP/1.1\r\nHost: "+host+"\r\nAccept: application/json\r\nUser-Agent: WardriveHub-SF\r\nX-API-Key: "+key+"\r\nConnection: close\r\n\r\n");
  int code=sfReadResponse(c,response);c.stop();return code;
}
static int sfValidateKey(const String& host,const String& key){
  if(key.length()==0)return 0;
  String body;int code=sfHttpsGet(host,key,"/api/v1/device/me",body);
  if(code==200 && sfJsonField(body,"ok")!="true")return -7;
  return code;
}
static bool sfValidJobId(const String& id){
  if(id.length()!=36)return false;
  for(size_t i=0;i<id.length();i++){
    char c=id[i];
    if(!((c>='0'&&c<='9')||(c>='a'&&c<='f')||(c>='A'&&c<='F')||c=='-'))return false;
  }
  return true;
}
static String sfPendingMarker(const String& path,const String& host,const String& key,size_t size){
  uint32_t h=2166136261UL;
  String seed=path+"|"+host+"|"+String((unsigned long)size)+"|"+key;
  for(size_t i=0;i<seed.length();i++){h^=(uint8_t)seed[i];h*=16777619UL;}
  char name[30];snprintf(name,sizeof(name),"/sf_job_%08lx.txt",(unsigned long)h);
  return String(name);
}
static bool sfWaitForJob(const String& host,const String& key,const String& id,int& code,String& result){
  for(int attempt=0;attempt<12;attempt++){
    String body;
    code=sfHttpsGet(host,key,"/api/v1/uploads/"+id,body);
    if(code==200){
      String status=sfJsonField(body,"status");
      if(status=="done") {result="SERVER DONE";return true;}
      if(status=="failed") {result="SERVER PROCESSING FAILED";return false;}
      if(status!="queued" && status!="processing") {result="UNKNOWN JOB STATUS";return false;}
      result=status=="queued"?"QUEUED, NOT ARCHIVED":"PROCESSING, NOT ARCHIVED";
    }else if(code==401||code==403){result="INVALID API KEY";return false;}
    else if(code==404){result="JOB NOT FOUND";return false;}
    else if(code==429){result="RATE LIMITED";return false;}
    else if(code<0){result="JOB STATUS CONNECTION ERROR";return false;}
    else {result="JOB STATUS HTTP "+String(code);return false;}
    delay(1750);
  }
  code=202;return false; // Keep the job marker and original CSV for later verification.
}
static bool sfSubmitCsv(const String& csv,const String& host,const String& key,int& code,String& result){
  code=0;result="";
  if(key.length()==0){result="SIGNAL FRONTIER KEY MISSING";return false;}
  if(!sfSafeHost(host)||key.indexOf('\r')>=0||key.indexOf('\n')>=0){result="INVALID SIGNAL FRONTIER HOST/KEY";return false;}
  File f=SD.open(csv,FILE_READ);
  if(!f){result="CSV NOT FOUND";return false;}
  const size_t fileSize=f.size();
  if(fileSize==0){f.close();result="EMPTY CSV";return false;}
  String marker=sfPendingMarker(csv,host,key,fileSize);
  String jobId="";
  if(SD.exists(marker)){
    File existing=SD.open(marker,FILE_READ);
    if(existing){jobId=existing.readStringUntil('\n');jobId.trim();existing.close();}
    if(!sfValidJobId(jobId)){SD.remove(marker);jobId="";}
  }
  if(!jobId.length()){
    String filename=csv;
    int slash=filename.lastIndexOf('/');if(slash>=0)filename=filename.substring(slash+1);
    filename.replace('"','_');filename.replace('\n','_');filename.replace('\r','_');
    String boundary="----WDHFrontier"+String((unsigned long)esp_random(),HEX);
    String before="--"+boundary+"\r\nContent-Disposition: form-data; name=\"file\"; filename=\""+filename+"\"\r\nContent-Type: text/csv\r\n\r\n";
    String after="\r\n--"+boundary+"--\r\n";
    WiFiClientSecure c;c.setInsecure();c.setTimeout(20000);c.setHandshakeTimeout(20);
    if(!c.connect(host.c_str(),443)) {f.close();c.stop();code=-3;result="TLS CONNECT FAIL";return false;}
    c.print("POST /api/upload-csv HTTP/1.1\r\nHost: "+host+"\r\nAccept: application/json\r\nUser-Agent: WardriveHub-SF\r\nX-API-Key: "+key+"\r\nContent-Type: multipart/form-data; boundary="+boundary+"\r\nContent-Length: "+String((unsigned long)(before.length()+fileSize+after.length()))+"\r\nConnection: close\r\n\r\n");
    if(c.print(before)!=before.length()){f.close();c.stop();code=-2;result="MULTIPART HEADER SEND FAILED";return false;}
    bool sent=true;uint8_t chunk[768];
    while(f.available()){
      size_t n=f.read(chunk,sizeof(chunk));
      if(!n)break;
      size_t off=0;
      while(off<n){size_t written=c.write(chunk+off,n-off);if(!written){sent=false;break;}off+=written;}
      if(!sent)break;
      delay(0);
    }
    f.close();
    if(sent && c.print(after)!=after.length())sent=false;
    if(!sent){c.stop();code=-2;result="CSV SEND FAILED";return false;}
    String body;code=sfReadResponse(c,body);c.stop();
    if(code!=202){result=code==401||code==403?"INVALID API KEY":("UPLOAD HTTP "+String(code));return false;}
    jobId=sfJsonField(body,"job_id");
    if(!sfValidJobId(jobId)){result="QUEUED, JOB ID MISSING";return false;}
    File pending=SD.open(marker,FILE_WRITE);
    if(!pending){result="QUEUED, CANNOT SAVE JOB ID";return false;}
    pending.println(jobId);pending.close();
  }else f.close();
  bool completed=sfWaitForJob(host,key,jobId,code,result);
  if(completed || result=="SERVER PROCESSING FAILED" || result=="JOB NOT FOUND")SD.remove(marker);
  return completed;
}

// Preserve the existing CYD maintenance/scan pause behavior for every service.
// Confirmation is based on Signal Frontier job status "done", not HTTP 202.
bool streamSignalFrontierCsv(const String& csv,int& code,String& responseBody){
  bool ok=sfSubmitCsv(csv,uploadSignalFrontierHost,uploadSignalFrontierKey,code,responseBody);
  uploadStatus=ok?"SIGNAL FRONTIER DONE":responseBody;
  return ok;
}

// Archive a confirmed upload. Never replace an existing SD file.
static bool cydArchiveUploadedCsv(const String& source) {
  if(!source.endsWith(".csv") || source.indexOf("..")>=0 || !SD.exists(source))return false;
  if(isUploadedCsvPath(source))return true;
  if(!SD.exists(UPLOADED_CSV_DIR) && !SD.mkdir(UPLOADED_CSV_DIR))return false;
  String name=sessionDisplayName(source);
  if(name.length()==0 || name.indexOf('/')>=0 || name.indexOf('\\')>=0)return false;
  String destination=String(UPLOADED_CSV_DIR)+"/"+name;
  if(SD.exists(destination)){
    String stem=name.substring(0,name.length()-4);
    bool found=false;
    for(unsigned n=1;n<1000;n++){
      destination=String(UPLOADED_CSV_DIR)+"/"+stem+"_"+String(n)+".csv";
      if(!SD.exists(destination)){found=true;break;}
    }
    if(!found)return false;
  }
  if(!SD.rename(source,destination))return false;
  // A currently selected live CSV must NOT be reopened under the old contents.
  // When scanning resumes, start a fresh current file with a valid CSV header.
  if(source==currentSessionFile){
    sessionStoragePrepared=false;
    ensureSessionFile();
    sessionStoragePrepared=SD.exists(currentSessionFile);
  }
  Serial.printf("[CSV] Archived: %s -> %s\n",source.c_str(),destination.c_str());
  return true;
}

bool uploadSelectedCsv(bool doWigle,bool doWdg,bool doSignalFrontier){
  if(csvUiSelected<0 || csvUiSelected>=csvUiCount){uploadStatus="SELECT FILE";return false;}
  String csv=csvUiFiles[csvUiSelected];
  if(!SD.exists(csv)){uploadStatus="CSV NOT FOUND";return false;}
  // Upload automatically pauses and resumes capture using beginUploadMaintenance().
  if(!connectUploadWifi()){restoreCoreAfterUpload();return false;}

  bool allOk=true;
  if(doWigle){
    if(!uploadWigleApiKey.length()){uploadStatus="WIGLE KEY MISSING";drawUploadProgress("WIGLE",UP_FAILED,-1,"API KEY MISSING");allOk=false;}
    else{
      int code=0;String body;uploadStatus="UPLOADING WIGLE";forceRedraw=true;
      String auth=wigleBasicAuth();
      bool ok=auth.length() && streamCsvUpload("api.wigle.net","/api/v2/file/upload","Authorization",auth,csv,true,code,body);
      if(ok && body.indexOf("\"success\":false")>=0) ok=false;
      cydUploadHistory(csv,"WIGLE",code,ok);
       if(!ok){uploadStatus=String("WIGLE FAILED ")+code;drawUploadProgress("WIGLE",UP_FAILED,100,String("HTTP ")+code);allOk=false;}
      else {uploadStatus="WIGLE UPLOAD OK";drawUploadProgress("WIGLE",UP_SUCCESS,100,"SERVER CONFIRMED");wdhCooperativeWait(650);}
    }
  }
  if(doWdg){
    if(!uploadWdgKey.length()){uploadStatus="WDGWARS KEY MISSING";drawUploadProgress("WDGWARS",UP_FAILED,-1,"API KEY MISSING");allOk=false;}
    else{
      int code=0;String body;uploadStatus="UPLOADING WDGWARS";forceRedraw=true;
      bool ok=streamCsvUpload("wdgwars.pl","/api/upload-csv","X-API-Key",uploadWdgKey,csv,false,code,body);
      if(ok && body.indexOf("\"ok\":false")>=0) ok=false;
      cydUploadHistory(csv,"WDGWARS",code,ok);
       if(!ok){uploadStatus=String("WDGWARS FAILED ")+code;drawUploadProgress("WDGWARS",UP_FAILED,100,String("HTTP ")+code);allOk=false;}
      else {if(allOk) uploadStatus=doWigle?"UPLOAD BOTH OK":"WDGWARS UPLOAD OK";drawUploadProgress("WDGWARS",UP_SUCCESS,100,"SERVER CONFIRMED");wdhCooperativeWait(650);}
    }
  }
  if(doSignalFrontier){
    if(!uploadSignalFrontierKey.length()){
      uploadStatus="FRONTIER KEY MISSING";
      drawUploadProgress("FRONTIER",UP_FAILED,-1,"API KEY MISSING");allOk=false;
    }else{
      int code=0;String body;
      uploadStatus="UPLOADING FRONTIER";forceRedraw=true;
      bool ok=streamSignalFrontierCsv(csv,code,body);
      cydUploadHistory(csv,"SIGNAL_FRONTIER",code,ok);
      if(!ok){
        uploadStatus=(code==202)?"FRONTIER QUEUED":(String("FRONTIER FAILED ")+code);
        drawUploadProgress("FRONTIER",code==202?UP_VERIFYING:UP_FAILED,100,
                           code==202?"WAITING FOR SERVER":(String("HTTP ")+code));
        allOk=false;
      }
      else{uploadStatus="FRONTIER VERIFIED";drawUploadProgress("FRONTIER",UP_SUCCESS,100,"SERVER CONFIRMED");wdhCooperativeWait(650);}
    }
  }
  // Archive only if EVERY destination selected for this operation succeeded.
  // A partial upload remains green/pending for retry.
  bool archiveOk=true;
  if(allOk && (doWigle||doWdg||doSignalFrontier)){
    archiveOk=cydArchiveUploadedCsv(csv);
    if(!archiveOk)Serial.println("[CSV] Upload succeeded, SD archive failed; source retained");
  }
  restoreCoreAfterUpload();
  if(!archiveOk)uploadStatus="UPLOAD OK / ARCHIVE FAILED";
  if(doWigle && doWdg && !doSignalFrontier){
    if(allOk){uploadStatus="UPLOAD BOTH OK";drawUploadProgress("WIGLE + WDGWARS",UP_SUCCESS,100,"BOTH CONFIRMED");}
    else {uploadStatus="UPLOAD BOTH: CHECK RESULTS";drawUploadProgress("WIGLE + WDGWARS",UP_FAILED,100,"ONE OR MORE FAILED");}
  }
  if(doWigle&&doWdg&&doSignalFrontier)uploadStatus=allOk?"ALL THREE VERIFIED":(uploadStatus=="FRONTIER QUEUED"?"FRONTIER QUEUED":"CHECK SERVICE HISTORY");
  if(!archiveOk)uploadStatus="UPLOAD OK / ARCHIVE FAILED";
  if(archiveOk && allOk)refreshCsvUiList();
  return allOk && archiveOk;
}

// Upload all CSVs currently visible in the SD session index to SignalFrontier.
// Existing scanner controls are preserved, and active sessions remain blocked.
bool uploadAllCsvSignalFrontier(){
  // Upload automatically pauses and resumes capture using beginUploadMaintenance().
  if(!ensureUploadSd()){uploadStatus="SD OFFLINE";return false;}
  if(!loadUploadConfig() || !uploadSignalFrontierKey.length()){
    uploadStatus="SF CONFIG/KEY MISSING";return false;
  }
  if(!connectUploadWifi()){restoreCoreAfterUpload();return false;}
  File root=SD.open(CSV_SESSION_DIR);
  int uploaded=0,failed=0,found=0;
  String confirmed[CSV_UI_MAX];uint8_t confirmedCount=0;
  if(root){
    File f=root.openNextFile();
    while(f){
      String n=String(f.name());
      const bool isFile=!f.isDirectory();
      f.close();
      int slash=n.lastIndexOf('/');if(slash>=0)n=n.substring(slash+1);
      if(isFile && n.endsWith(".csv")){
        String path=String(CSV_SESSION_DIR)+"/"+n;
        found++;
        int code=0;String body;
        bool ok=streamSignalFrontierCsv(path,code,body);
        cydUploadHistory(path,"SIGNAL_FRONTIER",code,ok);
        if(ok){uploaded++;if(confirmedCount<CSV_UI_MAX)confirmed[confirmedCount++]=path;}
        else failed++;
      }
      f=root.openNextFile();
      yield();
    }
    root.close();
  }
  int archiveFailed=0;
  for(uint8_t i=0;i<confirmedCount;i++) if(!cydArchiveUploadedCsv(confirmed[i]))archiveFailed++;
  restoreCoreAfterUpload();
  uploadStatus=found?String("SF ")+uploaded+" OK "+failed+" FAIL"+(archiveFailed?" ARCHIVE FAIL":""):"NO CSV FILES";
  if(uploaded>0)refreshCsvUiList();
  return found>0 && failed==0 && archiveFailed==0;
}

