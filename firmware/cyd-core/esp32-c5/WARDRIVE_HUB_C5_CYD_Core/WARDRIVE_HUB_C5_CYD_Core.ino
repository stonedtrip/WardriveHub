    tft.setCursor(tx,y+18);
    tft.print(labels[i]);
  }
}

void drawDashboardCaptureControls() {
  // Controls are derived from the real capture/session state.
  // STOPPED: full-width START. RUNNING: PAUSE + STOP. PAUSED: RESUME + STOP.
  const int by=174, bh=30;
  if (!wardriveActive && newSessionPending) {
    tft.fillRoundRect(18,by,204,bh,5,C_BLACK);
    tft.drawRoundRect(18,by,204,bh,5,C_GREEN);
    textAt(105,by+11,"START",C_GREEN,1);
    return;
  }

  // Deliberate 12px visual/touch dead gap between PAUSE/RESUME and STOP.
  const int leftX=18, leftW=96, rightX=126, rightW=96;
  uint16_t leftColor=wardriveActive?C_YELLOW:C_GREEN;
  const char* leftLabel=wardriveActive?"PAUSE":"RESUME";
  tft.fillRoundRect(leftX,by,leftW,bh,5,C_BLACK);
  tft.drawRoundRect(leftX,by,leftW,bh,5,leftColor);
  textAt(leftX + max(3,(leftW-(int)strlen(leftLabel)*6)/2),by+11,leftLabel,leftColor,1);

  tft.fillRoundRect(rightX,by,rightW,bh,5,C_BLACK);
  tft.drawRoundRect(rightX,by,rightW,bh,5,C_RED);
  textAt(rightX + max(3,(rightW-4*6)/2),by+11,"STOP",C_RED,1);
}

void drawDiscoveryCounter(int16_t x, int16_t y, int16_t colW, uint32_t value, uint16_t color) {
  String v=String(value);
  uint8_t sz=(v.length()<=3)?3:((v.length()<=5)?2:1);
  int16_t tw=(int16_t)v.length()*6*sz;
  int16_t tx=x+(colW-tw)/2;
  if(tx<x) tx=x;
  // Clear only this counter cell so changing digit count never leaves stale pixels.
  tft.fillRect(x,y,colW,24,C_PANEL);
  textAt(tx,y,v,color,sz);
}

