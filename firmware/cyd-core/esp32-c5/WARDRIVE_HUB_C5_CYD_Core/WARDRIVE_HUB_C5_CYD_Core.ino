  else if(gpsSavedYear) snprintf(z,sizeof(z),"%02u:%02u:%02u UTC",gpsSavedHour,gpsSavedMinute,gpsSavedSecond);
  else return "--";
  return String(z);
}

static time_t wdhUtcEpoch(uint16_t yr,uint8_t mo,uint8_t dy,uint8_t hr,uint8_t mi,uint8_t se){
  int y=(int)yr; unsigned m=mo,d=dy;
  y -= m <= 2;
  const int era=(y>=0 ? y : y-399)/400;
  const unsigned yoe=(unsigned)(y-era*400);
  const unsigned doy=(153*(m+(m>2 ? -3 : 9))+2)/5+d-1;
  const unsigned doe=yoe*365+yoe/4-yoe/100+doy;
  int64_t days=(int64_t)era*146097+(int64_t)doe-719468;
  return (time_t)(days*86400LL+(int64_t)hr*3600LL+(int64_t)mi*60LL+se);
}
static void setUtcSystemClockSafe(time_t e){
  if(e<1700000000)return;
  struct timeval tv; tv.tv_sec=e; tv.tv_usec=0;
  settimeofday(&tv,nullptr);
}
static void restoreSavedUtcSystemClockSafe(){
  if(!gpsSavedYear)return;
  setUtcSystemClockSafe(wdhUtcEpoch(gpsSavedYear,gpsSavedMonth,gpsSavedDay,
                                    gpsSavedHour,gpsSavedMinute,gpsSavedSecond));
}
static void syncUtcSystemClockFromGpsSafe(){
  // Do not call restored/cached GPS fields "live".  GPS LIVE is earned only
  // when BOTH date and time have been updated by the parser very recently
  // during this boot, after the startup guard period.
  if(millis()-gpsClockBootGuardMs < 2500UL) return;
  if(!gps.date.isValid() || !gps.time.isValid()) return;
  if(!gps.date.isUpdated() || !gps.time.isUpdated()) return;
  if(gps.date.age()>1500UL || gps.time.age()>1500UL) return;

  time_t e=wdhUtcEpoch(gps.date.year(),gps.date.month(),gps.date.day(),
                       gps.time.hour(),gps.time.minute(),gps.time.second());
  if(e<1700000000) return;

  time_t n=time(nullptr);
  if(n<1700000000 || llabs((long long)e-(long long)n)>=2) setUtcSystemClockSafe(e);

  gpsFreshTimeAcceptedMs=millis();
  gpsClockLiveThisBoot=true;
  wdhState.gpsFreshThisBoot=true;
}
static String clockStatusSourceText(){
  if(wdhState.gpsFreshThisBoot && gpsFreshTimeAcceptedMs>0) return "GPS LIVE";
  if(gpsSavedYear) return "LAST GPS SAVED";
  return "WAITING FOR GPS";
}
static String clockStatusUtcText(){
  time_t n=time(nullptr);
  if(n<1700000000) return "--/--/----  --:--:-- UTC";
  struct tm u={};
  gmtime_r(&n,&u);
  char b[32];
  snprintf(b,sizeof(b),"%02d/%02d/%04d  %02d:%02d:%02d UTC",
           u.tm_mon+1,u.tm_mday,u.tm_year+1900,u.tm_hour,u.tm_min,u.tm_sec);
  return String(b);
}

