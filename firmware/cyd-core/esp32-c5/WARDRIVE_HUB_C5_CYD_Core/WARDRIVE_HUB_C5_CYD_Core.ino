void updatePageDynamic() {
  if(systemHealthActive) {
    if((uint32_t)(millis()-lastSystemHealthDrawMs)>=1000UL) updateSystemHealthFields();
    lastUiRefresh=millis();
    return;
  }
  if(gpsTestActive) {
    updateGpsTestDynamic();
    return;
  }

  switch(page) {
    case PAGE_DASH:     updateDashboardDynamic(); break;
    case PAGE_NODES:    updateNodesDynamic(); break;
    case PAGE_LIVE:     updateLiveDynamic(); break;
    case PAGE_CSV:    updateCsvDynamic(); break;
    case PAGE_SETTINGS: updateSettingsDynamic(); break;
  }

  lastUiNodeCount=nodeCount;
  lastUiLiveHead=liveHead;
  lastUiLiveCount=liveCount;
  lastUiRefresh=millis();
}

void drawPage() {
  if(sessionSummaryActive){ drawSessionSummary(); forceRedraw=false; return; }
  if(diagnosticEventsActive){ drawDiagnosticEventsPage(); forceRedraw=false; return; }
  if(selfTestActive){ drawSelfTestPage(); forceRedraw=false; return; }
  if(systemHealthActive) {
    drawSystemHealthPage();
    forceRedraw=false;
    return;
  }
  if(gpsTestActive) {
    drawGpsTestPage();
    forceRedraw=false;
    return;
  }
  tft.fillScreen(C_BLACK);
  drawHeader();
  switch(page) {
    case PAGE_DASH: drawDashboardPortrait(); break;
    case PAGE_NODES: drawNodesPage(); break;
    case PAGE_LIVE:
      if(liveView==LIVE_POPULARITY) channelPopularityNeedsFullDraw=true;
      if(liveView==LIVE_SMART) liveMetricsFullDraw=true;
      drawLivePage(); break;
    case PAGE_CSV: drawCsvPage(); break;
    case PAGE_SETTINGS: drawSettingsPage(); break;
  }

  tft.fillRect(0,tft.height()-44,tft.width(),7,C_PANEL);
  drawNav();
  forceRedraw=false;
  lastUiNodeCount=nodeCount;
  lastUiLiveHead=liveHead;
  lastUiLiveCount=liveCount;
  lastUiRefresh=millis();
}

