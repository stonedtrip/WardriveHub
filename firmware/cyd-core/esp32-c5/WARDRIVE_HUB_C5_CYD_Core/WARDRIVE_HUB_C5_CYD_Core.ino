static uint32_t lastGpsTimeSaveMs=0;
static constexpr uint32_t GPS_TIME_SAVE_MS=300000UL; // 5 minutes

static bool gpsDateTimeValidSafe(){
  return gps.date.isValid() && gps.time.isValid() &&
         gps.date.year()>=2024 && gps.date.year()<=2099;
}
static void restoreLastGpsDateTimeSafe(){
  Preferences p;
  if(!p.begin("wdhtime",true)) return;
  gpsSavedYear=p.getUShort("yr",0);
  gpsSavedMonth=p.getUChar("mo",0); gpsSavedDay=p.getUChar("dy",0);
  gpsSavedHour=p.getUChar("hr",0); gpsSavedMinute=p.getUChar("mi",0); gpsSavedSecond=p.getUChar("se",0);
  p.end();
}
static void saveGpsDateTimeSafe(){
  if(!gpsDateTimeValidSafe()) return;
  gpsSavedYear=gps.date.year(); gpsSavedMonth=gps.date.month(); gpsSavedDay=gps.date.day();
  gpsSavedHour=gps.time.hour(); gpsSavedMinute=gps.time.minute(); gpsSavedSecond=gps.time.second();
  gpsDateTimeSeen=true;
  if(lastGpsTimeSaveMs && millis()-lastGpsTimeSaveMs<GPS_TIME_SAVE_MS) return;
  Preferences p;
  if(p.begin("wdhtime",false)){
    p.putUShort("yr",gpsSavedYear); p.putUChar("mo",gpsSavedMonth); p.putUChar("dy",gpsSavedDay);
    p.putUChar("hr",gpsSavedHour); p.putUChar("mi",gpsSavedMinute); p.putUChar("se",gpsSavedSecond);
    p.end();
  }
  lastGpsTimeSaveMs=millis();
}
static String gpsDateTextSafe(){
