int apiAuthProbe(const String& host,const String& path,const String& hn,const String& hv,const char* method="GET"){
  // TLS handshakes can occasionally fail immediately after switching the radio
  // from ESP-NOW/promiscuous capture to the infrastructure AP. Retry the probe
  // instead of turning a transient socket failure into an INVALID-key result.
  // Distinguish name-resolution failures from connection and response failures.
  // No certificate, upload-request, or authentication behavior is changed.
  IPAddress resolved;
  if(WiFi.hostByName(host.c_str(),resolved)!=1) return -2;
  bool anyConnection=false;
  for(uint8_t attempt=0; attempt<3; ++attempt){
    WiFiClientSecure c;
    c.setInsecure();
    c.setTimeout(20000); c.setHandshakeTimeout(20);
    if(!c.connect(host.c_str(),443)){
      char tlsDetail[112]={0};
      int tlsErr=c.lastError(tlsDetail,sizeof(tlsDetail));
      Serial.printf("[UPLOAD TEST] %s TLS failure attempt %u: code=%d detail=%s internal_free=%u internal_largest=%u psram_free=%u\n",
                    host.c_str(), (unsigned)(attempt+1), tlsErr, tlsDetail,
                    (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
                    (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT),
                    (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT));
      c.stop(); delay(180 + attempt*180); continue;
    }
    anyConnection=true;
    c.print(String(method)+" "+path+" HTTP/1.1\r\nHost: "+host+"\r\nUser-Agent: WardriveHub-NM-CYD-C5/"+String(WARDHUB_FW_VERSION)+"\r\nAccept: application/json\r\n");
    if(hn.length()) c.print(hn+": "+hv+"\r\n");
    c.print("Connection: close\r\n\r\n");
    uint32_t t=millis();
    while(!c.available()&&c.connected()&&millis()-t<20000UL){
      if(externalGpsEnabled){uint8_t budget=0;while(GPSSerial.available()&&budget++<32)gps.encode(GPSSerial.read());}
      delay(10);
    }
    if(!c.available()){c.stop();delay(180 + attempt*180);continue;}
    String st=c.readStringUntil('\n');st.trim();
    int sp=st.indexOf(' ');
    int code=sp>0?st.substring(sp+1).toInt():0;
    c.stop();
    if(code>0) return code;
    delay(180 + attempt*180);
  }
  return anyConnection ? -4 : -3;
}

void runUploadApiTest(){
  apiTestResultActive=true;
  apiTestSd=ensureUploadSd()?"OK":"FAIL";
  apiTestCfg="--";apiTestWifi="--";apiTestWigle="--";apiTestWdg="--";apiTestSignalFrontier="--";
  drawApiTestResults();
  if(apiTestSd!="OK") return;
  bool cfg=loadUploadConfig();
  bool complete=cfg && uploadWifiSsid.length();
  apiTestCfg=complete?"OK":"MISSING";drawApiTestResults();
  if(!complete) return;
  // Preserve running and per-node pause states across the API check.
  if(!connectUploadWifi()){apiTestWifi="FAILED";drawApiTestResults();restoreCoreAfterUpload();return;}
  apiTestWifi="OK";apiTestWigle="TESTING";apiTestWdg="TESTING";drawApiTestResults();
  wdhCooperativeWait(250); // let STA/TCP stack settle before the first TLS handshake

  // WiGLE WIGLE_API_KEY is the account page's already-encoded "Encoded for use"
  // Basic credential. Test and real uploads use the exact same stored value.
  String auth=wigleBasicAuth();
  if(!auth.length())apiTestWigle="OFF";
  else{
    int wc=apiAuthProbe("api.wigle.net","/api/v2/profile/user","Authorization",auth,"GET");
    if(wc>=200&&wc<300) apiTestWigle="VALID";
    else if(wc==401||wc==403) apiTestWigle="INVALID";
    else if(wc==-2) apiTestWigle="DNS FAIL";
    else if(wc==-3) apiTestWigle="TLS CONNECT FAIL";
    else if(wc==-4) apiTestWigle="HTTP TIMEOUT";
    else if(wc<0) apiTestWigle="CONNECT FAIL";
    else apiTestWigle=String("HTTP ")+wc;
  }
  drawApiTestResults();

  // WDGWARS provides /api/me specifically for validating X-API-Key without
  // uploading a file. This avoids the unreliable OPTIONS/upload-route probe.
  if(!uploadWdgKey.length())apiTestWdg="OFF";
  else{
    int dc=apiAuthProbe("wdgwars.pl","/api/me","X-API-Key",uploadWdgKey,"GET");
    if(dc>=200&&dc<300) apiTestWdg="VALID";
    else if(dc==401||dc==403) apiTestWdg="INVALID";
    else if(dc==-2) apiTestWdg="DNS FAIL";
    else if(dc==-3) apiTestWdg="TLS CONNECT FAIL";
    else if(dc==-4) apiTestWdg="HTTP TIMEOUT";
    else if(dc<0) apiTestWdg="CONNECT FAIL";
    else apiTestWdg=String("HTTP ")+dc;
  }
  if(uploadSignalFrontierKey.length()){
    apiTestSignalFrontier="TESTING";drawApiTestResults();
    int sc=sfValidateKey(uploadSignalFrontierHost,uploadSignalFrontierKey);
    if(sc==200)apiTestSignalFrontier="VALID";
    else if(sc==401||sc==403)apiTestSignalFrontier="INVALID";
    else if(sc==404)apiTestSignalFrontier="NO ENDPOINT";
    else if(sc==429)apiTestSignalFrontier="RATE LIMIT";
    else if(sc==-3)apiTestSignalFrontier="TLS FAIL";
    else if(sc==-4)apiTestSignalFrontier="TIMEOUT";
    else if(sc==-7)apiTestSignalFrontier="BAD RESPONSE";
    else if(sc==-8)apiTestSignalFrontier="BAD HOST";
    else if(sc>=500)apiTestSignalFrontier="SERVER FAIL";
    else apiTestSignalFrontier=String("HTTP ")+sc;
  }else apiTestSignalFrontier="OFF";
  restoreCoreAfterUpload();
  drawApiTestResults();
}

