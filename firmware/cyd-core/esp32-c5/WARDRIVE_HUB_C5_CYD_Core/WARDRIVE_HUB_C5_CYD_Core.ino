bool isUniqueBle(const String& addr) {

  uint16_t used = (uniqueBleDevices < uniqueBleCapacity) ? (uint16_t)uniqueBleDevices : uniqueBleCapacity;
  if (wdh::containsAddress(addr.c_str(), uniqueBleAddr, used, uniqueBleIndex, uniqueBleIndexSlots)) return false;
  if (used < uniqueBleCapacity) {
    addr.substring(0,17).toCharArray(uniqueBleAddr[used],18);
    wdh::indexAddress(uniqueBleAddr[used],used,uniqueBleIndex,uniqueBleIndexSlots);
    uniqueBleDevices++;
    return true;
  }
  return false;
}

