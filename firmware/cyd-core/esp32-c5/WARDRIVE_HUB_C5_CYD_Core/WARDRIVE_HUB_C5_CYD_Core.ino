bool uploadSdReady=false, uploadMenuActive=false;
String uploadWifiSsid,uploadWifiPass,uploadWigleApiKey,uploadWdgKey,uploadSignalFrontierKey,uploadStatus;
String uploadSignalFrontierHost="signalfrontier.org";

bool ensureUploadSd(){
  if(uploadSdReady) return true;
  uploadSdReady=wdhStorageEnsureMounted();
  if(uploadSdReady) csvSessionSdReady=true;
  return uploadSdReady;
}

bool loadUploadConfig(){
  uploadWifiSsid="";uploadWifiPass="";uploadWigleApiKey="";uploadWdgKey="";uploadSignalFrontierKey="";uploadSignalFrontierHost="signalfrontier.org";
  if(!ensureUploadSd())return false;
  File f=SD.open("/uploadcfg.txt","r");
  if(!f) f=SD.open("/wardrive_upload.cfg","r"); // legacy fallback
  if(!f)return false;
  while(f.available()){
    String l=f.readStringUntil('\n');l.trim();
    if(l.length()>=3 && (uint8_t)l[0]==0xEF && (uint8_t)l[1]==0xBB && (uint8_t)l[2]==0xBF) l.remove(0,3);
    if(!l.length()||l[0]=='#')continue;
    int e=l.indexOf('=');if(e<1)continue;
    String k=l.substring(0,e),v=l.substring(e+1);k.trim();k.toUpperCase();v.trim();
    if(k=="WIFI_SSID")uploadWifiSsid=v;
    else if(k=="WIFI_PASSWORD"||k=="WIFI_PASS")uploadWifiPass=v;
    else if(k=="WIGLE_API_KEY")uploadWigleApiKey=v;
    else if(k=="WDGWARS_API_KEY"||k=="WDGWARS_KEY")uploadWdgKey=v;
    else if(k=="SIGNAL_FRONTIER_API_KEY")uploadSignalFrontierKey=v;
    else if(k=="SIGNAL_FRONTIER_HOST")uploadSignalFrontierHost=v;
  }
  f.close();
  if(!uploadWifiSsid.length()){uploadStatus="CONFIG: WIFI_SSID MISSING";return false;}
  return true;
}

String wigleBasicAuth(){
  // WIGLE_API_KEY is WiGLE's already-encoded "Encoded for use" value.
  // Accept either the bare encoded value or a value already prefixed with Basic.
  String key=uploadWigleApiKey; key.trim();
  if(!key.length()) return "";
  if(key.startsWith("Basic ") || key.startsWith("basic ")) return String("Basic ")+key.substring(6);
  return String("Basic ")+key;
}

