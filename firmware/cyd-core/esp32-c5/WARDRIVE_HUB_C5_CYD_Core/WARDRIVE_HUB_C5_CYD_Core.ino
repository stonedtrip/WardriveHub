void applyWardriveGreenTheme() {
  C_ACCENT=0x07F1;
  C_PANEL=0x1126;
  C_DARKGREY=0x2145;
}

uint32_t hubSettingsChecksum(const uint8_t* p, size_t n) {
  uint32_t hash=2166136261UL;
  for(size_t i=0;i<n;i++){hash^=p[i];hash*=16777619UL;}
  return hash;
}

void saveHubSettings() {
  if(!hubStorageReady) return;
  HubSettingsRecord record={};
  record.magic=HUB_SETTINGS_MAGIC;
  record.version=1;
  record.standalone=0; // legacy record layout retained; no user-controlled standalone flag
  record.csvlog=csvLoggingEnabled?1:0;
  record.autostart=autoStartEnabled?1:0;
  record.gpsmode=2;
  record.legacyTheme=0;
  record.reserved[0]=scanAggressivenessIndex;
  record.reserved[1]=0xA6;
  record.checksum=hubSettingsChecksum(
    reinterpret_cast<const uint8_t*>(&record),
    offsetof(HubSettingsRecord,checksum));

  LittleFS.remove(HUB_SETTINGS_TEMP);
  File f=LittleFS.open(HUB_SETTINGS_TEMP,FILE_WRITE);
  if(!f) return;
  size_t written=f.write(reinterpret_cast<const uint8_t*>(&record),sizeof(record));
  f.flush();
  f.close();
  if(written!=sizeof(record)){LittleFS.remove(HUB_SETTINGS_TEMP);return;}
  LittleFS.remove(HUB_SETTINGS_FILE);
  if(!LittleFS.rename(HUB_SETTINGS_TEMP,HUB_SETTINGS_FILE))
    LittleFS.remove(HUB_SETTINGS_TEMP);
}

void loadHubSettings() {
  csvLoggingEnabled=true;
  autoStartEnabled=false;
  scanAggressivenessIndex=2;
  if(hubStorageReady && LittleFS.exists(HUB_SETTINGS_FILE)){
    HubSettingsRecord record={};
    File f=LittleFS.open(HUB_SETTINGS_FILE,FILE_READ);
    size_t read=f ? f.read(reinterpret_cast<uint8_t*>(&record),sizeof(record)) : 0;
    if(f) f.close();
    uint32_t expectedChecksum=hubSettingsChecksum(
      reinterpret_cast<const uint8_t*>(&record),
      offsetof(HubSettingsRecord,checksum));
    if(read==sizeof(record) && record.magic==HUB_SETTINGS_MAGIC &&
       record.version==1 && record.checksum==expectedChecksum){
      csvLoggingEnabled=record.csvlog!=0;
      autoStartEnabled=record.autostart!=0;
      if(record.reserved[1]==0xA6 && record.reserved[0]<4) scanAggressivenessIndex=record.reserved[0];
      else if(record.reserved[1]==0xA5 && record.reserved[0]<4) scanAggressivenessIndex=(record.reserved[0]==3)?2:record.reserved[0];
    }
  }
  applyWardriveGreenTheme();
}

