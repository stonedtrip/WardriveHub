enum WdhNodeState : uint8_t {
  NODE_OFFLINE=0, NODE_DISCOVERED, NODE_NEGOTIATING, NODE_READY,
  NODE_RUNNING, NODE_GPS_WAIT, NODE_DEGRADED, NODE_RECOVERING
};

static WdhNodeState nodeCoordinatorState(const NodeInfo &n) {
  if (!n.active) return NODE_OFFLINE;
  const uint32_t age = millis() - n.lastSeenMs;
  if (age > 8000UL) return NODE_DEGRADED;
  if (n.transportRecoveries && n.reliableLastRxMs && (millis()-n.reliableLastRxMs)>5000UL) return NODE_RECOVERING;
  if (!n.statusSeen) return n.capabilitySeenMs ? NODE_NEGOTIATING : NODE_DISCOVERED;
  if (!wardriveActive || !n.desiredRun) return NODE_READY;
  if (!gpsFix()) return NODE_GPS_WAIT;
  if (n.statusFlags & 0x04) return NODE_RUNNING;
  return NODE_READY;
}

static const char* nodeCoordinatorStateName(WdhNodeState s) {
  switch(s){
    case NODE_DISCOVERED:return "DISCOVERED"; case NODE_NEGOTIATING:return "NEGOTIATING";
    case NODE_READY:return "READY"; case NODE_RUNNING:return "RUNNING";
    case NODE_GPS_WAIT:return "GPS WAIT"; case NODE_DEGRADED:return "DEGRADED";
    case NODE_RECOVERING:return "RECOVERING"; default:return "OFFLINE";
  }
}

