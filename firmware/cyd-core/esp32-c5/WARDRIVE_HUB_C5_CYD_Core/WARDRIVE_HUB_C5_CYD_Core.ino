// Event-driven LIVE telemetry. Static headings are drawn only on page entry;
// changing values/bars clear only their own bounded rectangles.
bool liveMetricsFullDraw=true;
static void liveMetricText(int x,int y,int width,const String &value,uint16_t color,String &previous,bool full) {
  if(!full && value==previous)return;
  tft.fillRect(x,y,width,12,C_BLACK);
  textAt(x,y,value,color,1);
  previous=value;
}
void drawSmartChannelsPage() {
  const bool full=liveMetricsFullDraw;
  static String previous[4];
  static uint32_t previousBars[6]={};
  static uint8_t previousChannels[6]={};
  static uint16_t previousScores[6]={};
  if(full){
    tft.fillRect(0,32,tft.width(),tft.height()-72,C_BLACK);
    textAt(8,37,"SMART CHANNELS",C_CYAN,1);
    textAt(8,tft.height()-55,"Tap LIVE to return to MAP",C_LIGHTGREY,1);
    for(auto &v:previous)v="";
    for(int i=0;i<6;i++){previousBars[i]=0;previousChannels[i]=0;previousScores[i]=0;}
  }
  liveMetricText(8,51,224,smartAggressiveEnabled()?"SMART AGGRESSIVE ACTIVE":"Select SMART in scan settings",smartAggressiveEnabled()?C_GREEN:C_YELLOW,previous[0],full);
  liveMetricText(8,65,224,String("REVISITS ")+smartRevisitsCompleted+"  SKIPPED "+smartRevisitsSuppressed,C_LIGHTGREY,previous[1],full);
  // Efficiency is calculated from actual session-unique BSSIDs, not raw beacons.
  const uint32_t discoveryRate = (uint32_t)((uint64_t)uniqueNetworks*60000ULL / (wardriveElapsedMs()?wardriveElapsedMs():1UL));
  const String pressureText = smartPressureHigh()?"QUEUE: YIELDING":"QUEUE: NORMAL";
  liveMetricText(8,79,224,pressureText+"  NEW/MIN "+String(discoveryRate),smartPressureHigh()?C_YELLOW:C_GREEN,previous[2],full);
  struct Hot {uint8_t index;uint16_t score;} hot[6]={};
  for(uint8_t i=0;i<STANDALONE_SCAN_CHANNEL_COUNT;i++){
    uint16_t score=smartChannelScore[i];if(!score)continue;
    for(uint8_t k=0;k<6;k++)if(score>hot[k].score){
      for(int j=5;j>(int)k;j--)hot[j]=hot[j-1];
      hot[k]={i,score};break;
    }
  }
  liveMetricText(13,122,215,hot[0].score?"":"Waiting for channel activity...",C_LIGHTGREY,previous[3],full);
  uint16_t peak=hot[0].score?hot[0].score:1;
  for(uint8_t k=0;k<6;k++){
    uint8_t ch=hot[k].score?STANDALONE_SCAN_CHANNELS[hot[k].index]:0;
    uint32_t bar=hot[k].score?(uint32_t)hot[k].score*97U/peak:0;
    if(!full && previousChannels[k]==ch && previousScores[k]==hot[k].score && previousBars[k]==bar)continue;
    int y=105+(int)k*25;
    tft.fillRect(8,y-2,224,17,C_BLACK);
    if(ch){
      textAt(9,y,String("CH ")+ch,ch>14?C_MAGENTA:C_GREEN,1);
      tft.drawRect(57,y-2,101,12,C_DARKGREY);
      if(bar)tft.fillRect(59,y,bar,8,C_ACCENT);
      textAt(164,y,String(hot[k].score),C_WHITE,1);
    }
    previousChannels[k]=ch;previousScores[k]=hot[k].score;previousBars[k]=bar;
  }
  liveMetricsFullDraw=false;
}

