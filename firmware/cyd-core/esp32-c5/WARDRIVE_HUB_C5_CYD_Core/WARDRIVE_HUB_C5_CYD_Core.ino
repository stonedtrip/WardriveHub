bool parseFirmwareVersion(const String& name,uint16_t &ma,uint16_t &mi,uint16_t &pa){
  int v=-1;
  for(int i=0;i<(int)name.length()-1;i++) if((name[i]=='v'||name[i]=='V') && isDigit(name[i+1])) {v=i+1;break;}
  if(v<0) return false;
  int d1=name.indexOf('.',v); if(d1<0) return false;
  int d2=name.indexOf('.',d1+1); if(d2<0) return false;
  int e=d2+1; while(e<(int)name.length() && isDigit(name[e])) e++;
  if(e==d2+1) return false;
  ma=(uint16_t)name.substring(v,d1).toInt();
  mi=(uint16_t)name.substring(d1+1,d2).toInt();
  pa=(uint16_t)name.substring(d2+1,e).toInt();
  return true;
}

bool firmwareVersionNewer(uint16_t ma,uint16_t mi,uint16_t pa){
  if(ma!=FW_VER_MAJOR) return ma>FW_VER_MAJOR;
  if(mi!=FW_VER_MINOR) return mi>FW_VER_MINOR;
  return pa>FW_VER_PATCH;
}

void considerUpdateFile(const String& path,String &bestPath,uint16_t &bma,uint16_t &bmi,uint16_t &bpa){
  String low=path; low.toLowerCase();
  if(!low.endsWith(".bin")) return;
  uint16_t ma=0,mi=0,pa=0;
  if(!parseFirmwareVersion(path,ma,mi,pa) || !firmwareVersionNewer(ma,mi,pa)) return;
  bool better=bestPath.length()==0 || ma>bma || (ma==bma && (mi>bmi || (mi==bmi && pa>bpa)));
  if(better){bestPath=path;bma=ma;bmi=mi;bpa=pa;}
}

void scanUpdateDirectory(const char* dirPath,String &bestPath,uint16_t &bma,uint16_t &bmi,uint16_t &bpa){
  File dir=SD.open(dirPath);
  if(!dir || !dir.isDirectory()){if(dir)dir.close();return;}
  File f=dir.openNextFile();
  while(f){
    if(!f.isDirectory()){
      String n=f.name();
      String full=n.startsWith("/")?n:(String(dirPath)+(String(dirPath).endsWith("/")?"":"/")+n);
      considerUpdateFile(full,bestPath,bma,bmi,bpa);
    }
    f.close(); f=dir.openNextFile();
  }
  dir.close();
}

static constexpr const char* SD_UPDATE_PENDING_MARKER = "/.wdh_update_pending";

static bool validateFirmwareImageFile(File &f,String &why){
  if(!f || f.isDirectory()){ why="OPEN FAILED"; return false; }
  const size_t sz=f.size();
  if(sz<65536){ why="FILE TOO SMALL"; return false; }
  uint8_t hdr[16]={};
  if(f.seek(0) && f.read(hdr,sizeof(hdr))==sizeof(hdr) && hdr[0]==0xE9){
    // Compare the extended-header chip id (bytes 12-13) with the image we are running,
    // so an image built for another chip (C6, S3, ...) is rejected before flashing.
    const esp_partition_t* run=esp_ota_get_running_partition();
    uint8_t rh[16]={};
    if(run && esp_partition_read(run,0,rh,sizeof(rh))==ESP_OK && rh[0]==0xE9){
      if(hdr[12]!=rh[12] || hdr[13]!=rh[13]){ f.seek(0); why="WRONG CHIP IMAGE"; return false; }
    }
    f.seek(0); why="OK"; return true;
  }
  f.seek(0); why="INVALID ESP IMAGE"; return false;
}

void archiveConfirmedSdUpdate(){
  if(!ensureCsvSessionSd()) return;
  if(!SD.exists(SD_UPDATE_PENDING_MARKER)) return;
  if(!SD.exists("/update.bin")){
    Serial.println("[UPDATE] pending marker exists but update.bin is absent");
    return;
  }
  String installedPath=String("/installed_v")+WARDHUB_FW_VERSION+".bin";
  SD.remove(installedPath);
  File src=SD.open("/update.bin",FILE_READ);
  if(!src || src.isDirectory()){ if(src)src.close(); return; }
  uint32_t expected=(uint32_t)src.size();
  File dst=SD.open(installedPath,FILE_WRITE);
  if(!dst){ src.close(); return; }
  uint8_t buf[2048]; uint32_t copied=0;
  while(src.available()){
    size_t n=src.read(buf,sizeof(buf)); if(!n)break;
    size_t w=dst.write(buf,n); copied+=(uint32_t)w;
    if(w!=n)break;
    yield();
  }
  dst.flush(); dst.close(); src.close();
  File verify=SD.open(installedPath,FILE_READ);
  uint32_t actual=verify?(uint32_t)verify.size():0;
  if(verify)verify.close();
  if(expected>0 && copied==expected && actual==expected){
    if(SD.remove("/update.bin")){
      SD.remove(SD_UPDATE_PENDING_MARKER);
      Serial.printf("[UPDATE] archived as %s\n",installedPath.c_str());
    }
  }else{
    SD.remove(installedPath);
  }
}

void findSdFirmwareUpdate(){
  sdUpdatePrompt=false; sdUpdatePath=""; sdUpdateVersion=""; sdUpdateMessage="CHECKING SD...";
  forceRedraw=true;
  if(!ensureCsvSessionSd()){sdUpdateMessage="SD CARD NOT FOUND";return;}
  const esp_partition_t* next=esp_ota_get_next_update_partition(nullptr);
  if(!next){sdUpdateMessage="NO UPDATE PARTITION";return;}

  // Direct-flash SD workflow: use the normal Arduino application binary, renamed update.bin.
  // Never feed a merged/full-flash image to the OTA application partition.
  const char* candidates[]={"/update.bin","/wardrive hub/update/update.bin","/WardriveHub/update.bin"};
  String found="";
  for(size_t i=0;i<sizeof(candidates)/sizeof(candidates[0]);i++){
    File t=SD.open(candidates[i],FILE_READ);
    if(t && !t.isDirectory()){found=candidates[i];t.close();break;}
    if(t)t.close();
  }
  if(!found.length()){
    sdUpdateMessage = "NO UPDATE.BIN - INSTALLED ARCHIVE KEPT";
    return;
  }
  File f=SD.open(found,FILE_READ);
  if(!f || f.isDirectory()){if(f)f.close();sdUpdateMessage="UPDATE.BIN OPEN FAIL";return;}
  size_t sz=f.size();
  if(sz<65536){f.close();sdUpdateMessage="UPDATE.BIN TOO SMALL";return;}
  if(sz>next->size){f.close();sdUpdateMessage="UPDATE.BIN TOO LARGE";return;}
  uint8_t magic=0; if(f.read(&magic,1)!=1){f.close();sdUpdateMessage="UPDATE.BIN READ FAIL";return;}
  f.close();
  if(magic!=0xE9){sdUpdateMessage="NOT APP FIRMWARE";return;}

  sdUpdatePath=found;
  sdUpdateVersion="SD update.bin";
  sdUpdateMessage=String("FOUND update.bin  ")+String((unsigned)(sz/1024))+" KB";
  sdUpdatePrompt=true;
}
