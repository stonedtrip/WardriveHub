static const uint8_t CSV_ROWS_VISIBLE=4;
String csvUiMessage="";
// Uploaded CSVs live under the existing SD CSV folder, next to pending
// recordings. Legacy root-level archives remain visible to avoid data loss.
static const char* UPLOADED_CSV_DIR="/wardrive hub/csv/Uploaded CSVs";
static const char* LEGACY_UPLOADED_CSV_DIR="/Uploaded CSVs";
static bool isUploadedCsvPath(const String& p) {
  return p.startsWith(String(UPLOADED_CSV_DIR)+"/") ||
         p.startsWith(String(LEGACY_UPLOADED_CSV_DIR)+"/");
}

void refreshCsvUiList(){
  csvUiCount=0;
  for(int i=0;i<CSV_UI_MAX;i++){csvUiFiles[i]="";csvUiSizes[i]=0;}
  if(!ensureCsvSessionSd()){csvUiSelected=-1;csvUiPage=0;csvUiMessage="SD OFFLINE";return;}
  // Keep the archive visible in Windows even before the first upload.
  if(!SD.exists(UPLOADED_CSV_DIR))SD.mkdir(UPLOADED_CSV_DIR);
  if(SD.exists(currentSessionFile)){
    File f=SD.open(currentSessionFile,FILE_READ);
    if(f){csvUiFiles[csvUiCount]=currentSessionFile;csvUiSizes[csvUiCount++]=f.size();f.close();}
  }
  File root=SD.open(CSV_SESSION_DIR);
  if(root){
    File f=root.openNextFile();
    while(f && csvUiCount<CSV_UI_MAX){
      String n=f.name();
      int slash=n.lastIndexOf('/'); if(slash>=0) n=n.substring(slash+1);
      if(n.endsWith(".csv")){
        String full=String(CSV_SESSION_DIR)+"/"+n;
        if(full!=currentSessionFile){csvUiFiles[csvUiCount]=full;csvUiSizes[csvUiCount++]=f.size();}
      }
      f.close(); f=root.openNextFile();
    }
    root.close();
  }
  // Include new nested archive and older top-level archive in the CYD list.
  // Both are red/UPLOADED; only NEW uploads go into the nested folder.
  const char* archivedDirs[]={UPLOADED_CSV_DIR,LEGACY_UPLOADED_CSV_DIR};
  for(uint8_t dirIndex=0;dirIndex<2 && csvUiCount<CSV_UI_MAX;dirIndex++){
    File uploadedDir=SD.open(archivedDirs[dirIndex]);
    if(uploadedDir && uploadedDir.isDirectory()){
      File f=uploadedDir.openNextFile();
      while(f && csvUiCount<CSV_UI_MAX){
        String n=String(f.name());int slash=n.lastIndexOf('/');if(slash>=0)n=n.substring(slash+1);
        if(!f.isDirectory() && n.endsWith(".csv")){
          csvUiFiles[csvUiCount]=String(archivedDirs[dirIndex])+"/"+n;
          csvUiSizes[csvUiCount++]=f.size();
        }
        f.close();f=uploadedDir.openNextFile();
      }
      uploadedDir.close();
    }
  }
  if(csvUiCount==0){csvUiSelected=-1;csvUiPage=0;}
  else {if(csvUiSelected<0||csvUiSelected>=csvUiCount)csvUiSelected=0;uint8_t maxPage=(csvUiCount-1)/CSV_ROWS_VISIBLE;if(csvUiPage>maxPage)csvUiPage=maxPage;}
}

bool deleteCsvFile(const String& req){
  if(!ensureCsvSessionSd()) return false;
  String p="";
  // Only delete a filename explicitly present in the CSV manager selection.
  for(uint8_t i=0;i<csvUiCount;i++) if(csvUiFiles[i]==req){p=req;break;}
  if(!p.length()||p.indexOf("..")>=0||!p.endsWith(".csv")||!SD.exists(p))return false;
  int oldSelected=csvUiSelected;
  bool ok=SD.remove(p);
  if(!ok){refreshCsvUiList();return false;}
  refreshCsvUiList();
  if(csvUiCount==0){csvUiSelected=-1;csvUiPage=0;}
  else {if(oldSelected<0)oldSelected=0;if(oldSelected>=csvUiCount)oldSelected=csvUiCount-1;csvUiSelected=oldSelected;csvUiPage=csvUiSelected/CSV_ROWS_VISIBLE;}
  return true;
}

