void initExpandedMemory() {
  for (int i=0;i<256;i++) channelBestRssi[i] = -32768;
  if (ESP.getPsramSize() == 0) {
    Serial.println("[MEM] PSRAM unavailable; using fallback history tables");
    return;
  }
  void* wifiMem = heap_caps_calloc(UNIQUE_CAP_PSRAM, 18, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  void* bleMem  = heap_caps_calloc(BLE_UNIQUE_CAP_PSRAM, 18, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (wifiMem) { uniqueBssid = reinterpret_cast<char (*)[18]>(wifiMem); uniqueBssidCapacity = UNIQUE_CAP_PSRAM; }
  if (bleMem)  { uniqueBleAddr = reinterpret_cast<char (*)[18]>(bleMem); uniqueBleCapacity = BLE_UNIQUE_CAP_PSRAM; }
  uniqueBssidIndexSlots=uniqueBssidCapacity*2;
  uniqueBleIndexSlots=uniqueBleCapacity*2;
  uniqueBssidIndex=(uint16_t*)heap_caps_calloc(uniqueBssidIndexSlots,sizeof(uint16_t),MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
  uniqueBleIndex=(uint16_t*)heap_caps_calloc(uniqueBleIndexSlots,sizeof(uint16_t),MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
  void* bleHashes=heap_caps_calloc(BLE_LOG_CAP*2,sizeof(uint64_t),MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
  if (bleHashes) { bleLogHashes=static_cast<uint64_t*>(bleHashes); bleLogCapacity=BLE_LOG_CAP; bleLogSlots=BLE_LOG_CAP*2; }
  void* liveBuffer=heap_caps_calloc(LIVE_CAP,sizeof(LiveRecord),MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
  if (liveBuffer) { liveRecords=static_cast<LiveRecord*>(liveBuffer); liveRecordCapacity=LIVE_CAP; }
  Serial.printf("[MEM] BLE hash cap=%u, live history cap=%u (PSRAM intended)\n",
                (unsigned)bleLogCapacity,(unsigned)liveRecordCapacity);
  Serial.printf("[MEM] unique tables: WiFi=%u BLE=%u / free PSRAM=%u\n",
                uniqueBssidCapacity, uniqueBleCapacity, (unsigned)ESP.getFreePsram());
}

