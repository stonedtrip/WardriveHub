void updateDashboardDynamic() {
  // Event-driven dashboard: GPS sentence traffic must never repaint the screen
  // while waiting for a fix. Only actual visible state/value changes are drawn.
  static bool cacheInit=false;
  static uint32_t c24=0xFFFFFFFFUL,c5=0xFFFFFFFFUL,cBle=0xFFFFFFFFUL;
  static uint32_t cTotal=0xFFFFFFFFUL,cUnique=0xFFFFFFFFUL,cBleUnique=0xFFFFFFFFUL;
  static bool cActive=false,cPending=false,cFix=false;
  static String cCap="",cGps="",cDrive="",cSource="";

  const bool fix=gpsFix();
  String cap = !wardriveActive ? (newSessionPending ? "WARDRIVE STOPPED" : "WARDRIVE PAUSED") :
               (!fix ? "WAITING FOR GPS" :
               (!cydIsStandalone() ? "RECORDING - NODES" : "RECORDING - CYD/EXT GPS"));
  String gpsLine=String(gpsLockText())+"  SAT "+gpsSatCount();
  float mph=activeGpsSpeedMph();
  float deg=activeGpsCourseDeg();
  String drive=String("SPD ")+(mph>=0?String(mph,1):String("--"))+" MPH  HDG "+headingShort(deg);
  String source=String("GPS ")+activeGpsSourceName();

  if(!cacheInit || c24!=total24){drawDiscoveryCounter(12,67,68,total24,C_WHITE);c24=total24;}
  if(!cacheInit || c5!=total5){drawDiscoveryCounter(86,67,68,total5,C_WHITE);c5=total5;}
  if(!cacheInit || cBle!=bleRecords){drawDiscoveryCounter(160,67,68,bleRecords,C_CYAN);cBle=bleRecords;}
  if(!cacheInit || cTotal!=totalRecords || cUnique!=uniqueNetworks){
    fillTextAt(18,116,204,10,String("WIFI ")+totalRecords+"  UNIQUE "+uniqueNetworks,C_LIGHTGREY,1,C_PANEL);
    cTotal=totalRecords;cUnique=uniqueNetworks;
  }
  if(!cacheInit || cBleUnique!=uniqueBleDevices){
    fillTextAt(18,128,204,10,String("BLE UNIQUE ")+uniqueBleDevices,C_LIGHTGREY,1,C_PANEL);
    cBleUnique=uniqueBleDevices;
  }

  if(!cacheInit || cCap!=cap || cFix!=fix){
    fillTextAt(18,160,204,10,cap,!wardriveActive?C_YELLOW:(fix?C_GREEN:C_YELLOW),1,C_PANEL);
    cCap=cap;
  }

  // Control strip only changes when the capture state changes, not on every GPS sentence.
  if(!cacheInit || cActive!=wardriveActive || cPending!=newSessionPending || cFix!=fix){
    tft.fillRect(14,171,tft.width()-28,36,C_PANEL);
    drawDashboardCaptureControls();
  }

  // While searching, keep these lines frozen. They repaint once on transition
  // into SEARCHING and once on transition to LOCKED. Once locked, visible values
  // update only when their rendered text actually changes.
  if(!cacheInit || cFix!=fix || (fix && cGps!=gpsLine)){
    fillTextAt(18,239,204,10,gpsLine,fix?C_GREEN:C_YELLOW,1,C_PANEL);
    cGps=gpsLine;
  }
  if(!cacheInit || cFix!=fix || (fix && cDrive!=drive)){
    fillTextAt(18,257,204,10,drive,C_WHITE,1,C_PANEL);
    cDrive=drive;
  }
  if(!cacheInit || cFix!=fix || (fix && cSource!=source)){
    fillTextAt(18,272,204,10,source,C_LIGHTGREY,1,C_PANEL);
    cSource=source;
  }

  cActive=wardriveActive;cPending=newSessionPending;cFix=fix;cacheInit=true;
}

void updateNodesDynamic() {
  // v1.3.45: flicker-free NODES updates. Static page chrome is never repainted here.
  // Only changed cluster values / changed node rows are touched. The list region is
  // cleared only when membership/order changes (node joins/leaves), because rows move.
  static bool cacheInit=false;
  static uint8_t cachedNodeCount=255;
  static uint8_t cachedSlots[MAX_NODES];
  static uint8_t cachedSlotCount=0;
  static String cachedRowSig[MAX_NODES];

  int w=tft.width(), h=tft.height();

  if(!cacheInit || cachedNodeCount!=nodeCount) {
    fillTextAt(17,61,40,24,String(nodeCount),C_GREEN,3,C_PANEL);
    cachedNodeCount=nodeCount;
  }

  uint8_t slots[MAX_NODES];
  uint8_t slotCount=0;
  for(uint8_t i=0;i<MAX_NODES;i++) if(nodes[i].active) slots[slotCount++]=i;

  bool structureChanged=!cacheInit || slotCount!=cachedSlotCount;
  if(!structureChanged) {
    for(uint8_t r=0;r<slotCount;r++) {
      if(slots[r]!=cachedSlots[r]) { structureChanged=true; break; }
    }
  }

  const int listY=102, rowH=43;
  if(structureChanged) {
    // A join/leave can move rows, so this is the one case where the list region
    // itself needs clearing. Header, cluster card and nav remain untouched.
    tft.fillRect(7,listY,w-14,h-142,C_BLACK);
    for(uint8_t r=0;r<MAX_NODES;r++) cachedRowSig[r]="";
    cachedSlotCount=slotCount;
    for(uint8_t r=0;r<slotCount;r++) cachedSlots[r]=slots[r];
  }

  uint8_t shown=0;
  for(uint8_t r=0;r<slotCount;r++) {
    uint8_t i=slots[r];
    int y=listY + shown*rowH;
    if(y+rowH > h-40) break;

    String mode=nodeModeName(nodes[i].statusSeen?nodes[i].reportedScanMode:nodes[i].desiredScanMode);
    bool scan=(nodes[i].statusFlags&0x04)!=0;
    bool ngps=(nodes[i].statusFlags&0x02)!=0;
    String line1=String("N")+(i+1)+" "+shortMac(nodes[i].mac)+" "+mode;
    String line2=String((wardriveActive && nodes[i].desiredRun && !gpsFix())?"GPS WAIT":((nodes[i].statusFlags&0x08)?"RUN ACK":(nodes[i].desiredRun?"RUN PENDING":"PAUSED")))+" "+(scan?"SCANNING":"NO SCAN");
    String line3=nodes[i].reliableAckCapable ? (nodes[i].reliableAckImmediateFail ? "ACK RETRY" : "ACK OK") :
                 (nodes[i].statusSeen ? ((nodes[i].statusFlags&0x10)?"BLE OK":"BLE N/A") : "BLE ?");
    String counts=String("RAW ")+nodes[i].wifiRecords+"W/"+nodes[i].bleRecordsNode+"B";
    String sig=line1+"|"+line2+"|"+line3+"|"+counts+"|"+String(nodes[i].statusFlags);

    if(structureChanged || cachedRowSig[r]!=sig) {
      // Repaint only this node's card, not the page or entire list.
      tft.fillRoundRect(7,y,w-14,rowH-4,5,C_PANEL);
      textAt(14,y+4,line1,C_WHITE,1);
      textAt(14,y+17,line2,scan?C_GREEN:C_YELLOW,1);
      textAt(14,y+28,line3,(nodes[i].statusFlags&0x10)?C_CYAN:C_YELLOW,1);
      textAt(w-10-(counts.length()*6),y+28,counts,C_LIGHTGREY,1);
      cachedRowSig[r]=sig;
    }
    shown++;
  }

  if(!shown && (structureChanged || !cacheInit)) {
    textAt(20,124,"No mesh nodes connected.",C_LIGHTGREY,1);
    textAt(20,141,"CYD standalone capture active",C_GREEN,1);
  }

  cacheInit=true;
}

void drawLiveDotsIncremental() {
  if(!liveMapCenterValid || liveCount==0) return;
  // Only paint records that arrived since the previous UI service.  The old
  // implementation repainted the entire history whenever ONE capture arrived.
  uint16_t delta=0;
  if(liveCount>lastUiLiveCount) delta=(uint16_t)(liveCount-lastUiLiveCount);
  else if(liveHead!=lastUiLiveHead) delta=(uint16_t)((liveHead-lastUiLiveHead+liveRecordCapacity)%liveRecordCapacity);
  if(delta==0) return;
  if(delta>liveCount) delta=liveCount;

  // Tiny pixel cache: captures landing on the same display location do not
  // cause repeated SPI circles during this batch. CSV/history still keep all records.
  int16_t drawnX[24], drawnY[24]; uint8_t drawn=0;
  for(uint16_t n=delta; n>0; --n){
    int idx=(liveHead-n+liveRecordCapacity)%liveRecordCapacity; LiveRecord &r=liveRecords[idx];
    if(!r.hasGps) continue;
    int16_t x,y; liveWorldVectorToHeadingScreen(r.lat,r.lon,liveMapCenterLat,liveMapCenterLon,liveMapHeadingDeg,x,y);
    if(x<2||x>=tft.width()-2||y<LIVE_MAP_Y+2||y>=LIVE_MAP_Y+LIVE_MAP_H-2) continue;
    bool duplicate=false;
    for(uint8_t k=0;k<drawn;k++) if(abs(x-drawnX[k])<=2 && abs(y-drawnY[k])<=2){duplicate=true;break;}
    if(duplicate) continue;
    tft.fillCircle(x,y,3,(strcmp(r.auth,"BLE")==0)?C_BLUE:C_GREEN);
    if(drawn<24){drawnX[drawn]=x;drawnY[drawn]=y;drawn++;}
  }
}

void updateLiveDynamic() {
  const bool recordsChanged=(lastUiLiveHead!=liveHead || lastUiLiveCount!=liveCount);
  const uint32_t now=millis();

  // GPS-wait rendering is event-driven. The static WAITING FOR GPS view is
  // already painted when the page is entered, so do not clear/repaint it on
  // every 125 ms UI service tick. Repaint only on a real GPS state transition.
  static bool liveGpsStateKnown=false;
  static bool liveGpsHadFix=false;
  const bool liveGpsHasFix=gpsFix();

  if(liveView==LIVE_MAP) {
    if(!liveGpsStateKnown) {
      liveGpsStateKnown=true;
      liveGpsHadFix=liveGpsHasFix;
      if(!liveGpsHasFix) return;
    } else if(liveGpsHasFix != liveGpsHadFix) {
      liveGpsHadFix=liveGpsHasFix;
      liveMapCenterValid=false;
      drawLiveMapPage();
      lastUiLiveHead=liveHead; lastUiLiveCount=liveCount;
      return;
    }
  }

  if(liveView!=LIVE_MAP) {
    if(!recordsChanged && liveView!=LIVE_SMART) return;
    if(liveView==LIVE_SMART) {
      static uint32_t lastRfViewDrawMs=0;
      if((uint32_t)(now-lastRfViewDrawMs)<1000UL)return;
      lastRfViewDrawMs=now;
    }
    if(liveView==LIVE_POPULARITY) {
      // Retained-mode update: drawChannelAnalysisPage compares against the last
      // visible state and touches only rows/totals that actually changed.
      drawChannelAnalysisPage();
    } else {
      // Each telemetry view compares snapshots and redraws only changed fields.
      drawLivePage();
    }
    lastUiLiveHead=liveHead; lastUiLiveCount=liveCount;
    return;
  }

  if(!liveMapCenterValid) {
    // With no fix there is no map state to update; leave the already-rendered
    // waiting screen untouched. As soon as GPS becomes valid, the transition
    // block above performs the one required full redraw.
    if(!liveGpsHasFix) return;
    drawLiveMapPage();
    lastUiLiveHead=liveHead; lastUiLiveCount=liveCount;
    return;
  }

  if(recordsChanged) {
    drawLiveDotsIncremental();
    lastUiLiveHead=liveHead; lastUiLiveCount=liveCount;
  }

  if(!gpsFix() || (uint32_t)(now-lastLiveMarkerMs)<LIVE_MARKER_INTERVAL_MS) return;

  float rawCourse=activeGpsCourseDeg();
  float mph=activeGpsSpeedMph();
  bool headingMoved=(rawCourse>=0.0f && mph>=LIVE_HEADING_MIN_MPH &&
                     (!liveMapHeadingValid || liveAngleDelta(rawCourse,liveMapHeadingDeg)>=LIVE_HEADING_REDRAW_DEG));
  int16_t nx,ny;
  liveWorldVectorToHeadingScreen(activeGpsLat(),activeGpsLon(),liveMapCenterLat,liveMapCenterLon,liveMapHeadingDeg,nx,ny);
  bool positionMoved=(nx<LIVE_RECENTER_MARGIN || nx>=tft.width()-LIVE_RECENTER_MARGIN ||
                      ny<LIVE_MAP_Y+LIVE_RECENTER_MARGIN || ny>=LIVE_MAP_Y+LIVE_MAP_H-LIVE_RECENTER_MARGIN);
  // Do not let GPS course jitter repeatedly rebuild all 244 map rows. Position
  // recentering still happens immediately when the vehicle reaches the viewport
  // margin; heading-only rotation waits for a short redraw cooldown. GPS parsing,
  // capture logging and incremental dots continue at full rate during the wait.
  const bool fullRedrawCooldownDone = (uint32_t)(now-lastLiveMapDrawMs) >= LIVE_FULL_REDRAW_MIN_MS;
  if(positionMoved || (headingMoved && fullRedrawCooldownDone)) {
    drawLiveMapPage();
    lastUiLiveHead=liveHead; lastUiLiveCount=liveCount;
    return;
  }
  // Vehicle remains fixed in the center; the map moves/rotates beneath it.
  int16_t cx=tft.width()/2, cy=LIVE_MAP_Y+LIVE_MAP_H/2;
  tft.fillTriangle(cx,cy-8,cx-6,cy+6,cx+6,cy+6,C_WHITE);
  tft.drawTriangle(cx,cy-8,cx-6,cy+6,cx+6,cy+6,C_ACCENT);
  liveMarkerX=cx; liveMarkerY=cy; lastLiveMarkerMs=now;
}

