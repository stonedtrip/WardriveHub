static bool wdhInterruptedSessionAtBoot=false;
static void wdhSetSessionMarker(bool armed) {
  Preferences p;
  if(p.begin("wdh-session",false)) { p.putBool("unfinished",armed); p.end(); }
}
static void wdhLoadSessionMarker() {
  Preferences p;
  if(p.begin("wdh-session",true)) { wdhInterruptedSessionAtBoot=p.getBool("unfinished",false); p.end(); }
  if(wdhInterruptedSessionAtBoot) {
    wdhLogEvent("UNFINISHED SESSION - MANUAL START");
    Serial.println("[SESSION] Interrupted session found; waiting for manual START");
  }
}

bool flushCsvStage();  // forward declaration for STOP/update safety

void setWardriveActive(bool active) {

  bool stateChanged = (active != wardriveActive);

  if (active) {
    if (newSessionPending) {
      resetSessionDiscoveryCounters();
      newSessionPending = false;
      sessionStoragePrepared = false;
    }
    // Starting/resuming capture must have a real current CSV immediately.
    // On a brand-new session this archives the previous current file first.
    prepareSessionStorage();
    if (stateChanged) wardriveStartedMs = millis();
    wardriveActive = true;
    wdhSetSessionMarker(true);
    wdhInterruptedSessionAtBoot=false;
    
    lastStandaloneWifiMs = 0;
    lastStandaloneBleMs = 0;
    Serial.println("[WARD] Capture START/RE-ARM");
  } else {
    if (stateChanged) wardriveAccumulatedMs += millis() - wardriveStartedMs;
    if(sessionGpsDownSinceMs){
      uint32_t span=(uint32_t)(millis()-sessionGpsDownSinceMs);
      sessionGpsDownMs+=span; sessionGpsLastOutageMs=span;
      if(span>sessionGpsLongestMs) sessionGpsLongestMs=span;
      sessionGpsDownSinceMs=0;
    }
    const bool finalFlushOk=flushCsvStage();
    wardriveActive = false;
    // Preserve interruption evidence if SD could not commit all pending bytes.
    wdhSetSessionMarker(!finalFlushOk);
    if(!finalFlushOk) wdhLogEvent("STOP - CSV PENDING / RECOVERY NEEDED");
    Serial.println("[WARD] Standalone capture STOP");
  }

  for (uint8_t i=0; i<MAX_NODES; i++) {
    if (!nodes[i].active) continue;
    if(!uploadPreserveNodeStateOnResume) nodes[i].desiredRun = active;
    nodes[i].configGeneration++;
    if (!nodes[i].configGeneration) nodes[i].configGeneration = 1;
  }

  for (uint8_t pass=0; pass<3; pass++) {
    sendAllNodeConfigs();
    delay(15);
  }

  updatePageDynamic();
}

