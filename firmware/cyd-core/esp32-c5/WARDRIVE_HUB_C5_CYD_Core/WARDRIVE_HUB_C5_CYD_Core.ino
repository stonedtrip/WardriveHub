void drawNav() {
  int w=tft.width(), h=tft.height();
  const char* labels[5] = {"DASH","NODES","LIVE","CSV","SET"};
  const int navH=37;
  const int y=h-navH;
  const int bw=w/5;

  tft.fillRect(0,y,w,navH,C_PANEL);
  tft.drawFastHLine(0,y,w,C_DARKGREY);

  for(int i=0;i<5;i++) {
    bool active=(page==i && !gpsTestActive);
    uint16_t bg=active?C_BLACK:C_PANEL;

    tft.fillRect(i*bw,y+1,bw,navH-1,bg);
    if(active) tft.fillRect(i*bw+4,y+2,bw-8,3,C_ACCENT);

    tft.setTextSize(1);
    tft.setTextColor(active?C_WHITE:C_LIGHTGREY,bg);
