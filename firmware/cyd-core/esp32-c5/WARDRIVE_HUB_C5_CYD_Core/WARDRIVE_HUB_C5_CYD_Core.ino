bool readTouch(int &x,int &y) {
  // touchTick() already confirmed pressure. Avoid a second touched() SPI transaction
  // on the shared TFT/touch/SD bus; one getPoint() is enough for this event.
  TS_Point p = touch.getPoint();

  x = map(p.x, TOUCH_MIN_X, TOUCH_MAX_X, 0, tft.width()-1);
  y = map(p.y, TOUCH_MIN_Y, TOUCH_MAX_Y, 0, tft.height()-1);

  x = constrain(x, 0, tft.width()-1);
  y = constrain(y, 0, tft.height()-1);
  return true;
}

void touchTick() {
  // Poll fast enough for a responsive UI without needlessly hammering the shared SPI bus.
  // 8 ms = up to 125 Hz touch service; event debounce below still prevents double taps.
  static uint32_t lastTouchPollMs=0;
  const uint32_t now=millis();
  if(now-lastTouchPollMs<8) return;
  lastTouchPollMs=now;
  static bool touchLatched=false;
  if(!touch.touched()){ touchLatched=false; return; }
  if(touchLatched) return;
  if(now-lastTouchMs<45) return;
  int x,y;
  if(!readTouch(x,y)) return;
  touchLatched=true;
  lastTouchMs=now;
  int h=tft.height(), w=tft.width();

  if(sessionSummaryActive){ if(y>=244){ sessionSummaryActive=false; page=PAGE_SETTINGS; settingsPage=0; forceRedraw=true; } return; }
  if(diagnosticEventsActive){ if(y>=244){ diagnosticEventsActive=false; page=PAGE_SETTINGS; settingsPage=0; forceRedraw=true; } return; }
  if(selfTestActive){ if(y>=244){ selfTestActive=false; page=PAGE_SETTINGS; settingsPage=0; forceRedraw=true; } return; }
  if(systemHealthActive) {
    // Any tap on the bottom health action prints the full copy/paste report and returns.
    if(y>=244) { printSystemHealthReport(); systemHealthActive=false; page=PAGE_SETTINGS; settingsPage=1; forceRedraw=true; }
    return;
  }

  if(gpsTestActive) {
    if(y>=h-48) {
      gpsTestActive=false;
      page=PAGE_SETTINGS;
      forceRedraw=true;
    }
    return;
  }

  const int navY=h-37;
  if(y>=navY) {
    if(page==PAGE_CSV && x < (w/5)) { page=PAGE_DASH; uploadMenuActive=false; forceRedraw=true; return; }
    int idx=constrain(x/(w/5),0,4);
    if(idx==PAGE_SETTINGS && page==PAGE_SETTINGS) {
      scanAggPopup=false;
      settingsPage ^= 1;
    } else if(idx==PAGE_LIVE && page==PAGE_LIVE) {

      if(liveView==LIVE_MAP) liveView=LIVE_LIST;
      else if(liveView==LIVE_LIST) { liveView=LIVE_POPULARITY; channelPopularityNeedsFullDraw=true; }
      else if(liveView==LIVE_POPULARITY) liveView=LIVE_SMART;
      else if(liveView==LIVE_SMART) liveView=LIVE_MAP;
      else liveView=LIVE_MAP;
    } else {
      page=(Page)idx;
      if(page==PAGE_LIVE) { liveView=LIVE_MAP; liveMapZoomResolved=false; liveMapCenterValid=false; liveMarkerX=-1; liveMarkerY=-1; } 
    }
    forceRedraw=true;
    return;
  }

  if(page==PAGE_DASH) {
    // Portrait C5 CYD controls: START when stopped; PAUSE/RESUME + STOP once a session exists.
    if(h<400 && y>=174 && y<204) {
      if(!wardriveActive && newSessionPending) {
        if(x>=18 && x<222) { setWardriveActive(true); updateDashboardDynamic(); return; }
      } else {
        if(x>=18 && x<114) { setWardriveActive(!wardriveActive); updateDashboardDynamic(); return; }
        // x=114..125 is intentionally dead space between controls.
        if(x>=126 && x<222) { newSessionPending=true; setWardriveActive(false); updateDashboardDynamic(); return; }
      }
    }
    // Keep the existing landscape behavior untouched.
    if(h>=400 && x>=188 && y>=290 && y<326) {
      if(wardriveActive) setWardriveActive(false); else setWardriveActive(true);
      return;
    }
  }

  if(page==PAGE_NODES) {
    int rowY = (h<400) ? 102 : 47;
    int rowH = (h<400) ? 43 : 48;
    uint8_t shown=0;
    for(uint8_t i=0;i<MAX_NODES;i++) {
      if(!nodes[i].active) continue;
      int top=rowY + shown*rowH;
      if(y>=top && y<top+rowH-4) {
        if(x < (w*72)/100) changeNodeMode(i);
        else toggleNodeRun(i);
        return;
      }
      shown++;
    }
  }

  if(page==PAGE_CSV){
    if(uploadHistoryActive){uploadHistoryActive=false;forceRedraw=true;return;}
    if(!uploadMenuActive&&x>=132&&x<232&&y>=205&&y<228){uploadHistoryActive=true;forceRedraw=true;return;}
    if(uploadMenuActive){
      // Hit boxes exactly follow the visible 2x2 buttons; gaps are intentionally dead space.
      if(y>=108&&y<146){
        if(x>=22&&x<114){uploadMenuActive=false;uploadSelectedCsv(true,false,false);forceRedraw=true;return;}
        if(x>=126&&x<218){uploadMenuActive=false;uploadSelectedCsv(false,true,false);forceRedraw=true;return;}
      }
      if(y>=154&&y<192){
        if(x>=22&&x<114){uploadMenuActive=false;uploadSelectedCsv(false,false,true);forceRedraw=true;return;}
        if(x>=126&&x<218){uploadMenuActive=false;uploadSelectedCsv(true,true,true);forceRedraw=true;return;}
      }
      if(y>=207&&y<237){
        if(x>=22&&x<114){uploadMenuActive=false;uploadAllCsvSignalFrontier();forceRedraw=true;return;}
        if(x>=126&&x<218){uploadMenuActive=false;uploadStatus="";forceRedraw=true;return;}
      }
      return;
    }
    uint8_t maxPage=csvUiCount ? ((csvUiCount-1)/CSV_ROWS_VISIBLE) : 0;
    if(y>=40&&y<68){
      if(x>=148&&x<186){if(csvUiPage>0){csvUiPage--;drawCsvListRegion();}return;}
      if(x>=196&&x<234){if(csvUiPage<maxPage){csvUiPage++;drawCsvListRegion();}return;}
    }
    if(y>=82&&y<202){int row=(y-82)/30;if(row>=0&&row<CSV_ROWS_VISIBLE){int idx=csvUiPage*CSV_ROWS_VISIBLE+row;if(idx>=0&&idx<csvUiCount){int old=csvUiSelected;csvUiSelected=idx;csvUiMessage="";uploadStatus="";drawCsvSelectionRows(old,csvUiSelected);updateCsvDynamic();return;}}}

    if(y>=247&&y<268&&csvUiSelected>=0&&csvUiSelected<csvUiCount){
      if(x>=18&&x<108){uploadStatus="";uploadMenuActive=true;}
      else if(x>=132&&x<222){String v=csvUiFiles[csvUiSelected];bool ok=deleteCsvFile(v);csvUiMessage=ok?"CSV DELETED":"DELETE FAILED";}
      else return;
      forceRedraw=true;return;
    }
  }

  if(page==PAGE_SETTINGS){
    if(settingsPage==1){
      if(sdUpdatePrompt){
        if(y>=178&&y<214&&x>=24&&x<112){performSdFirmwareUpdate();return;}
        if(y>=178&&y<214&&x>=128&&x<216){sdUpdatePrompt=false;sdUpdateMessage="UPDATE CANCELLED";forceRedraw=true;return;}
        return;
      }
      if(apiTestResultActive){apiTestResultActive=false;forceRedraw=true;return;}
      if(scanAggPopup){
        if(x>=26 && x<tft.width()-26 && y>=103 && y<215){
          int idx=(y-103)/28;
          if(idx>=0 && idx<4){
            scanAggressivenessIndex=(uint8_t)idx;
            saveHubSettings();
            scanAggPopup=false;
            forceRedraw=true;
            return;
          }
        }
        scanAggPopup=false; forceRedraw=true; return;
      }
      if(x>=14&&x<tft.width()-14&&y>=76&&y<108){scanAggPopup=true;forceRedraw=true;return;}
      if(x>=18&&x<tft.width()-18&&y>=141&&y<169){runUploadApiTest();return;}
      if(x>=18&&x<tft.width()-18&&y>=174&&y<202){findSdFirmwareUpdate();forceRedraw=true;return;}
      return;
    }
    
    // GENERAL row
    if(y>=57&&y<84){
      const int margin=13,gap=5,generalBW=(w-margin*2-gap)/2;
      int col=-1; for(int i=0;i<2;i++){int bx=margin+i*(generalBW+gap); if(x>=bx&&x<bx+generalBW){col=i;break;}}
      if(col==0) csvLoggingEnabled=!csvLoggingEnabled;
      else if(col==1){autoStartEnabled=!autoStartEnabled;autoStartLatched=false;}
      else return;
      saveHubSettings();forceRedraw=true;return;
    }

    // DIAGNOSTICS 2x3 grid
    if(y>=119&&y<180){
      const int margin=13,gap=5,bw=(w-(margin*2)-(gap*2))/3,diagH=27,rowGap=7;
      int row=-1; if(y>=119&&y<146) row=0; else if(y>=153&&y<180) row=1; if(row<0) return;
      int col=-1; for(int i=0;i<3;i++){int bx=margin+i*(bw+gap); if(x>=bx&&x<bx+bw){col=i;break;}} if(col<0)return;
      int idx=row*3+col;
      if(idx==0){systemHealthActive=true;printSystemHealthReport();forceRedraw=true;return;}
      if(idx==1){diagnosticEventsActive=true;forceRedraw=true;return;}
      if(idx==2){selfTestActive=true;runWardhubSelfTest();forceRedraw=true;return;}
      if(idx==3){page=PAGE_NODES;forceRedraw=true;return;}
      if(idx==4){bool ok=exportWardhubDiagnostics();wdhLogEvent(ok?"EXPORT COMPLETE":"EXPORT FAILED");forceRedraw=true;return;}
      if(idx==5){sessionSummaryActive=true;forceRedraw=true;return;}
    }

    if(x>=70&&x<170&&y>=241&&y<270){gpsTestActive=true;forceRedraw=true;return;}
  }

}

bool startCoreRadio() {

  if(!WiFi.mode(WIFI_STA)) {
    Serial.println("[CORE] Wi-Fi STA init failed");
    return false;
  }
  WiFi.setAutoReconnect(false);
  WiFi.persistent(false);
  wdhCooperativeWait(80);

#if CONFIG_SOC_WIFI_SUPPORT_5G

  WiFi.setBandMode(WIFI_BAND_MODE_2G_ONLY);
#endif

  if (esp_now_init() != ESP_OK) {
    Serial.println("[CORE] ESP-NOW init failed");
    return false;
  }
  esp_now_register_recv_cb(onEspNowRecv);
  wdhCooperativeWait(40);
  setEspNowChannel();
  addPeer(BCAST);
  for (uint8_t i=0;i<MAX_NODES;i++) if (nodes[i].active) addPeer(nodes[i].mac);
  lastHeartbeatMs = millis();

  return true;
}

void drawBootStage(const char* stage, uint16_t color=C_WHITE) {
  tft.fillRect(18,250,204,24,C_BLACK);
  tft.setTextColor(color,C_BLACK);
  tft.setTextSize(1);
  tft.setCursor(18,258);
  tft.print(stage);
  Serial.printf("[BOOT] %s\n",stage);
  wdhCooperativeWait(35);
}

void setup() {
  { char bootEv[38]; snprintf(bootEv,sizeof(bootEv),"BOOT v%s",WARDHUB_FW_VERSION); wdhLogEvent(bootEv); }
  Serial.begin(115200);
  gpsClockBootGuardMs=millis();
  gpsClockLiveThisBoot=false;
  gpsFreshTimeAcceptedMs=0;
  wdhState.gpsFreshThisBoot=false;
  restoreLastGpsDateTimeSafe();
  restoreSavedUtcSystemClockSafe();
  wdhCooperativeWait(120);
  Serial.println();
  Serial.printf("=== Wardrive Hub Core v%s NM-CYD-C5 DirectFlash Optimized ===\n",WARDHUB_FW_VERSION);
  Serial.printf("[BOOT] reset reason=%d\n",(int)esp_reset_reason());
  wdhLoadSessionMarker();
  Serial.printf("[HW] Arduino core %s / flash=%u / psram=%u\n",
                ESP_ARDUINO_VERSION_STR,
                (unsigned)ESP.getFlashChipSize(),
                (unsigned)ESP.getPsramSize());

  if (bootGuardMagic != BOOT_GUARD_MAGIC) {
    bootGuardMagic = BOOT_GUARD_MAGIC;
    bootGuardCount = 0;
  }
  if (bootGuardCount < 255) bootGuardCount++;
  bootSafeMode = bootGuardCount >= 3;
  Serial.printf("[BOOT] guarded attempt=%u safe=%u\n",bootGuardCount,bootSafeMode?1:0);

  pinMode(TFT_BL,OUTPUT);
  digitalWrite(TFT_BL,LOW);

  pinMode(TFT_CS,OUTPUT); digitalWrite(TFT_CS,HIGH);
  pinMode(TOUCH_CS,OUTPUT); digitalWrite(TOUCH_CS,HIGH);
  pinMode(SD_CS,OUTPUT); digitalWrite(SD_CS,HIGH);
  sharedSPI.begin(TFT_SCLK,TFT_MISO,TFT_MOSI,TFT_CS);
  tft.init(240,320,SPI_MODE0);
  tft.setSPISpeed(20000000);
  tft.invertDisplay(false);
  tft.setRotation(2);
  tft.fillScreen(C_BLACK);
  digitalWrite(TFT_BL,HIGH);

  if (bootSafeMode) {
    tft.setTextWrap(true);
    textAt(20,48,"WARDRIVE HUB",C_GREEN,2);
    textAt(20,86,"C5 SAFE MODE",C_YELLOW,2);
    textAt(20,126,"RESET LOOP STOPPED",C_WHITE,1);
    textAt(20,150,"Power off, then retry.",C_WHITE,1);
    textAt(20,174,String("Firmware v")+WARDHUB_FW_VERSION,C_CYAN,1);
    Serial.println("[BOOT] SAFE MODE: optional subsystems held");
    return;
  }

  drawBootStage("DISPLAY OK",C_GREEN);

  const bool flash16MB=ESP.getFlashChipSize()>=15UL*1024UL*1024UL;
  const bool psram8MB=ESP.getPsramSize()>=7UL*1024UL*1024UL;
  drawBootStage(flash16MB?"16MB FLASH OK":"FLASH SETTING WRONG",
                flash16MB?C_GREEN:C_YELLOW);
  drawBootStage(psram8MB?"8MB PSRAM OK":"PSRAM DISABLED",
                psram8MB?C_GREEN:C_YELLOW);
  initExpandedMemory();
  initCsvStageBuffer();

  touch.begin(sharedSPI);
  touch.setRotation(0);
  drawBootStage("TOUCH OK",C_GREEN);

  hubStorageReady=LittleFS.begin(false);
  if(!hubStorageReady) hubStorageReady=LittleFS.begin(true);
  drawBootStage(hubStorageReady?"FILES OK":"FILES DISABLED",
                hubStorageReady?C_GREEN:C_YELLOW);
  loadHubSettings();
  drawBootStage("SETTINGS OK",C_GREEN);

  drawBootStage("STARTING GPS UART",C_CYAN);
  GPSSerial.setRxBufferSize(1024);   // must be called before begin()
  GPSSerial.begin(GPS_BAUD, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  externalGpsEnabled=(bool)GPSSerial;
  applyOrientation(true,false);
  drawBootStage(externalGpsEnabled?"GPS UART OK":"GPS UART FAILED",
                externalGpsEnabled?C_GREEN:C_YELLOW);

  tft.fillScreen(C_BLACK);
  int logoX=(tft.width()-STARTUP_LOGO_W)/2;
  tft.drawRGBBitmap(logoX,8,startupLogo,STARTUP_LOGO_W,STARTUP_LOGO_H);
  textAt(46,196,"WARDRIVE HUB",C_ACCENT,2);
  textAt(46,222,String("C5 CORE v")+WARDHUB_FW_VERSION,C_WHITE,1);
  tft.drawRoundRect(30,244,180,10,4,C_DARKGREY);
  tft.fillRoundRect(32,246,88,6,3,C_ACCENT);
  textAt(86,264,"INITIALIZING",C_LIGHTGREY,1);

  drawBootStage("STARTING ESP-NOW",C_CYAN);
  if (!startCoreRadio()) {
    tft.fillScreen(C_BLACK);
    textAt(15,30,"ESP-NOW INIT FAILED",C_RED,2);
    while(true) wdhCooperativeWait(1000);
  }
  drawBootStage("ESP-NOW OK",C_GREEN);

  uint8_t pri=0; wifi_second_chan_t sec;
  esp_wifi_get_channel(&pri,&sec);
  Serial.printf("[CORE] ESP-NOW listening channel: %u\n",pri);

  drawBootStage("STARTING BLE",C_CYAN);
  startLocalBleScanner();
  drawBootStage("BLE OK",C_GREEN);

  sessionStartMs=millis();
  wardriveStartedMs=millis();
  stableBootStartedMs=millis();

  // Archive only when the previous firmware completed an SD flash and rebooted.
  // A normal boot with update.bin present leaves that file completely untouched.
  archiveConfirmedSdUpdate();

  forceRedraw=true;
}

void loop() {
  if(bootSafeMode){wdhCooperativeWait(250);return;}

  if(bootGuardCount && millis()-stableBootStartedMs>15000UL){
    bootGuardCount=0;
  }

  // Low-rate diagnostics only; useful for proving whether a UI issue is heap/PSRAM pressure.
  static uint32_t lastMemDiagMs=0;
  if(millis()-lastMemDiagMs>=60000UL){
    lastMemDiagMs=millis();
    Serial.printf("[MEM] heap=%u largest=%u psram=%u wifiHist=%u/%u bleHist=%u/%u\n",
                  (unsigned)ESP.getFreeHeap(),
                  (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT),
                  (unsigned)ESP.getFreePsram(),
                  (unsigned)uniqueNetworks,(unsigned)uniqueBssidCapacity,
                  (unsigned)uniqueBleDevices,(unsigned)uniqueBleCapacity);
    Serial.printf("[COREHEALTH] recHWM=%lu ackHWM=%lu qdrop=%lu ackdrop=%lu chfix=%lu nodes=%u\n",
                  (unsigned long)coordinatorHealth.queueHighWater,
                  (unsigned long)coordinatorHealth.ackQueueHighWater,
                  (unsigned long)droppedQueuePackets,(unsigned long)reliableAckQueueDrops,
                  (unsigned long)coordinatorHealth.homeChannelRepairs,(unsigned)nodeCount);
  }
  if(externalGpsEnabled) {
    
    uint16_t gpsBytesThisLoop = 0;
    while (GPSSerial.available() && gpsBytesThisLoop < 192) {
      gps.encode(GPSSerial.read());
      gpsBytesThisLoop++;
    }
  }
  if(gpsDateTimeValidSafe()){
    syncUtcSystemClockFromGpsSafe();
    // NVS is only the boot fallback; avoid repeatedly writing the same clock.
    if(wdhState.gpsFreshThisBoot &&
       (wdhState.lastClockPersistMs==0 ||
        (uint32_t)(millis()-wdhState.lastClockPersistMs)>=60000UL)){
      saveGpsDateTimeSafe();
      wdhState.lastClockPersistMs=millis();
    }
  }

  if(autoStartEnabled && !wdhInterruptedSessionAtBoot){
    if(gpsFix()){
      if(!autoStartLatched){if(!wardriveActive){setWardriveActive(true); if(page==PAGE_DASH) updateDashboardDynamic();} autoStartLatched=true;}
    } else autoStartLatched=false;
  } else autoStartLatched=false;

  touchTick();
  csvStageTick();

  coreTick();
  if (nodeAssignmentsNeedRefresh) {
    nodeAssignmentsNeedRefresh = false;
    reassignChannels();
  }
  reliableTransportRecoveryTick();
  coordinatorHealthTick();

  touchTick();

  uint32_t nodeRetryNow = millis();
  if(nodeRetryNow - lastNodeConfigRetryMs >= 1000) {
    lastNodeConfigRetryMs = nodeRetryNow;
    for(uint8_t i=0; i<MAX_NODES; i++) {
      if(!nodes[i].active) continue; // retry even if the first node status was lost
      // Keep advertising the Core to legacy workers whose capability packet was lost.
      // Do not reassign channels or reset the node on routine advertisements.
      if (nodes[i].capabilitySeenMs == 0 ||
          (uint32_t)(nodeRetryNow - nodes[i].capabilitySeenMs) >= 10000UL) {
        setEspNowChannel();
        advertiseCoreCapabilities(nodes[i].mac);
        nodes[i].capabilitySeenMs = nodeRetryNow;
      }
      const bool expectedRun=wardriveActive && gpsFix() && nodes[i].desiredRun;
      const bool reportedRun=(nodes[i].statusFlags & 0x08)!=0;
      // Re-send if the node acknowledges RUN but reports the wrong scan mode.
      // This catches the observed RUN ACK / BLE / NO SCAN mismatch.
      const uint32_t caps = nodes[i].capabilityMask;
      const uint8_t expectedMode = (caps & (WDH_CAP_WIFI_2G | WDH_CAP_WIFI_5G)) ? 0 :
                                   ((caps & WDH_CAP_BLE_SCAN) ? 1 : 0);
      const bool wrongMode = nodes[i].statusSeen && nodes[i].reportedScanMode != expectedMode;
      if(!nodes[i].statusSeen || nodes[i].reportedGeneration != nodes[i].configGeneration || expectedRun != reportedRun || wrongMode) {
        setEspNowChannel();
        sendNodeConfig(i);
        // No blocking delay here: keep touch/GPS servicing responsive during retries.
        yield();
      }
    }
  }
  standaloneTick();
  scannerProgressWatchdog();

  touchTick();

  if(forceRedraw) drawPage();
  else {
    // Event-friendly refresh budget: Live Map gets smooth marker/dot service, other
    // active pages update fast enough to feel immediate, and idle pages stay quiet.
    uint32_t uiInterval = (page==PAGE_LIVE && liveView==LIVE_MAP) ? 125UL :
                          (wardriveActive ? 250UL : 750UL);
    if((uint32_t)(millis()-lastUiRefresh) >= uiInterval) updatePageDynamic();
  }

  // Yield to the RTOS/Wi-Fi stack without imposing a fixed UI/touch latency.
  yield();
}
