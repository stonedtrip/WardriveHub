void performSdFirmwareUpdate(){
  if(!sdUpdatePrompt || !sdUpdatePath.length() || sdUpdateBusy) return;
  sdUpdateBusy=true;
  File f=SD.open(sdUpdatePath,FILE_READ);
  if(!f){sdUpdateMessage="OPEN FAILED";sdUpdateBusy=false;sdUpdatePrompt=false;forceRedraw=true;return;}

  // Validate the ESP application image before touching the OTA partition.
  String imageWhy;
  if(!validateFirmwareImageFile(f,imageWhy)){
    sdUpdateMessage=imageWhy;
    f.close();
    sdUpdateBusy=false;
    sdUpdatePrompt=false;
    forceRedraw=true;
    Serial.printf("[UPDATE] rejected %s: %s\n",sdUpdatePath.c_str(),imageWhy.c_str());
    return;
  }

  size_t total=f.size();
  if(!Update.begin(total,U_FLASH)){f.close();sdUpdateMessage="UPDATE SLOT ERROR";sdUpdateBusy=false;sdUpdatePrompt=false;forceRedraw=true;return;}
  tft.fillScreen(C_BLACK); drawHeader();
  textAt(24,78,"INSTALLING FIRMWARE",C_ACCENT,1);
  textAt(24,100,"FROM SD /update.bin",C_WHITE,1);
  tft.drawRoundRect(20,138,200,18,5,C_DARKGREY);
  uint8_t buf[4096]; size_t done=0; int lastPct=-1; bool writeOk=true;
  while(f.available()){
    size_t n=f.read(buf,sizeof(buf)); if(!n)break;
    if(Update.write(buf,n)!=n){writeOk=false;break;}
    done+=n; int pct=(int)((done*100ULL)/total);
    if(pct!=lastPct){
      lastPct=pct; int bw=(pct*196)/100;
      tft.fillRect(22,140,196,14,C_BLACK); if(bw>0)tft.fillRect(22,140,bw,14,C_ACCENT);
      tft.fillRect(72,170,100,14,C_BLACK); textAt(94,172,String(pct)+"%",C_WHITE,1);
    }
    if(externalGpsEnabled){uint8_t b=0;while(GPSSerial.available()&&b++<32)gps.encode(GPSSerial.read());}
    yield();
  }
  f.close();
  if(!writeOk || !Update.end(true)){
    Update.abort(); sdUpdateMessage="UPDATE FAILED"; sdUpdateBusy=false; sdUpdatePrompt=false;
    textAt(55,205,"UPDATE FAILED",C_RED,1); wdhCooperativeWait(1600); forceRedraw=true; return;
  }
  // Only a completed flash is allowed to authorize post-boot archiving.
  // Persist proof of the successful flash on SD before reboot. This survives
  // the OTA partition switch reliably and cannot be created by a normal boot.
  SD.remove(SD_UPDATE_PENDING_MARKER);
  File pending=SD.open(SD_UPDATE_PENDING_MARKER,FILE_WRITE);
  if(pending){
    pending.print(WARDHUB_FW_VERSION);
    pending.flush();
    pending.close();
  } else {
    Serial.println("[UPDATE] WARNING: could not create pending archive marker");
  }
  textAt(45,205,"UPDATE COMPLETE",C_GREEN,1);
  textAt(60,225,"RESTARTING...",C_WHITE,1);
  wdhCooperativeWait(900); ESP.restart();
}

static uint8_t currentRecordQueueDepth(){
  const uint8_t head=recHead.load(),tail=recTail.load();
  return (tail>=head)?(tail-head):(REC_QUEUE_SIZE-head+tail);
}
static uint8_t currentAckQueueDepth(){
  const uint8_t head=ackHead.load(),tail=ackTail.load();
  return (tail>=head)?(tail-head):(ACK_QUEUE_SIZE-head+tail);
}
static uint32_t totalTransportRecoveries(){
  uint32_t n=0; for(uint8_t i=0;i<MAX_NODES;i++) if(nodes[i].active) n+=nodes[i].transportRecoveries; return n;
}
static uint32_t totalReliableDuplicates(){
  uint32_t n=0; for(uint8_t i=0;i<MAX_NODES;i++) if(nodes[i].active) n+=nodes[i].reliableDuplicates; return n;
}
static const char* systemHealthOverall(){
  if(ESP.getFreeHeap()<45000UL) return "DEGRADED";
  if(currentRecordQueueDepth()>72 || currentAckQueueDepth()>18) return "BUSY";
  if(csvHealthFlushFail>0 && csvStageUsed>0) return "STORAGE WAIT";
  for(uint8_t i=0;i<MAX_NODES;i++) if(nodes[i].active && nodeCoordinatorState(nodes[i])==NODE_DEGRADED) return "NODE DEGRADED";
  return "GOOD";
}

